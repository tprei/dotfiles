#!/usr/bin/env python3

import argparse
import json
import subprocess
import sys
from dataclasses import dataclass
from datetime import datetime, timedelta, timezone
from typing import Any


SETTLED_STATUSES = {"redeemed", "expired"}
JUNIPER_PROGRAM = "juniper_tide"


@dataclass(frozen=True)
class Spend:
    target: str
    credit_id: str
    expires_at: datetime


@dataclass(frozen=True)
class Problem:
    account: str
    credit_id: str | None
    reason: str


def positive_hours(value: str) -> float:
    parsed = float(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be a positive number of hours")
    return parsed


def parse_expiry(raw: str) -> datetime | None:
    try:
        parsed = datetime.fromisoformat(raw)
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return None
    return parsed


def plan(accounts: list[dict[str, Any]], now: datetime, deadline: datetime) -> tuple[list[Spend], list[Problem]]:
    spends: list[Spend] = []
    problems: list[Problem] = []
    for account in accounts:
        provider = account["provider"]
        if provider not in ("openai-codex", "anthropic"):
            continue
        name = f"{provider}/{account['credentialId']}"
        if account.get("error"):
            problems.append(Problem(name, None, f"could not list resets: {account['error']}"))
            continue
        expiring: list[tuple[datetime, dict[str, Any]]] = []
        for credit in account.get("credits", []):
            status = credit.get("status", "available")
            if status in SETTLED_STATUSES or "expiresAt" not in credit:
                continue
            if provider == "openai-codex" and status != "available":
                continue
            if credit.get("program") == JUNIPER_PROGRAM:
                continue
            when = parse_expiry(credit["expiresAt"])
            if when is None:
                problems.append(Problem(name, credit["id"], f"unreadable expiresAt {credit['expiresAt']!r}"))
            elif now < when <= deadline:
                expiring.append((when, credit))
        if not expiring:
            continue
        if provider == "openai-codex":
            when, credit = min(expiring, key=lambda item: item[0])
            spends.append(Spend(name, credit["id"], when))
            continue
        for when, credit in expiring:
            if credit["id"] != account.get("nextCreditId") or credit.get("usable") is not True:
                problems.append(Problem(name, credit["id"], f"expires {when.isoformat()} but Anthropic isn't offering it"))
            elif credit.get("requiresLimit") is True:
                problems.append(Problem(name, credit["id"], f"expires {when.isoformat()} but works only at a limit"))
            else:
                spends.append(Spend(name, credit["id"], when))
    return spends, problems


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Spend saved Codex and Claude rate-limit resets that expire within the window."
    )
    parser.add_argument("--within-hours", type=positive_hours, default=12.0)
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--omp", default="omp")
    args = parser.parse_args()

    listing = subprocess.run([args.omp, "usage", "reset", "--json"], capture_output=True, text=True)
    if listing.returncode != 0:
        sys.stderr.write(listing.stderr)
        return 1
    now = datetime.now(timezone.utc)
    spends, problems = plan(json.loads(listing.stdout)["accounts"], now, now + timedelta(hours=args.within_hours))

    failed = bool(problems)
    for problem in problems:
        subject = problem.account if problem.credit_id is None else f"{problem.account} credit {problem.credit_id}"
        print(f"{subject}: {problem.reason}", file=sys.stderr)
    for spend in spends:
        verb = "would spend" if args.dry_run else "spending"
        print(f"{spend.target}: {verb} credit {spend.credit_id}, expires {spend.expires_at.isoformat()}")
        if args.dry_run:
            continue
        result = subprocess.run([args.omp, "usage", "reset", spend.target], capture_output=True, text=True)
        sys.stdout.write(result.stdout)
        sys.stderr.write(result.stderr)
        if result.returncode != 0:
            failed = True
    if not spends and not failed:
        print(f"no saved reset expires within {args.within_hours:g}h")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
