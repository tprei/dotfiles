    "openai-codex": "0x6ee7b7",
    "anthropic": "0xf5a97f",
    "google-antigravity": "0x8aadf4",
    "opencode-go": "0xc6a0f6",
    "zai": "0xeed49f",
}
TOKEN_LOOKBACK_DAYS = 7
TOKEN_DAY_MS = 86_400_000
TOKEN_SSH_TIMEOUT_SECONDS = 60
TOKEN_SSH_HOST_ENV = "OMP_TOKEN_SSH_HOST"
TOKEN_SSH_PYTHON = "/usr/bin/python3"
TOKEN_SSH_BINARY = "/usr/bin/ssh"
LIMITS_STATE_KEY = "message_id"
TOKENS_STATE_KEY = "tokens_message_id"


class UsageError(Exception):
    """Running or validating the OMP usage payload failed."""

    def __init__(self, message: str, exit_code: int):
        super().__init__(message)
        self.exit_code = exit_code


class TelegramError(RuntimeError):
    """Telegram rejected a request or returned an unusable response."""
if str(TOKEN_USAGE_DIR) not in sys.path:
    sys.path.insert(0, str(TOKEN_USAGE_DIR))
try:
    import token_usage
except ImportError as error:
    token_usage = None
    TOKEN_USAGE_IMPORT_ERROR = error
else:
    TOKEN_USAGE_IMPORT_ERROR = None


def require_token_usage():
    if token_usage is None:
        raise UsageError("token usage collector not available", 1) from TOKEN_USAGE_IMPORT_ERROR
    return token_usage


def usable_report(report) -> bool:
    if not isinstance(report, dict):
        return False
    provider = report.get("provider")
    return isinstance(provider, str) and bool(provider.strip())


def usable_reports(payload: dict) -> list[dict]:
    reports = payload.get("reports")
    if not isinstance(reports, list):
        return []
    return [report for report in reports if usable_report(report)]


def run_omp_usage() -> dict:
    command = [os.environ.get("OMP_BIN", "omp"), "usage", "--json", "--redact"]
    try:
        completed = subprocess.run(
            command, capture_output=True, text=True, timeout=OMP_TIMEOUT_SECONDS, check=False
        )
    except FileNotFoundError:
        raise UsageError(f"OMP binary not found: {command[0]}", 1) from None
    except subprocess.TimeoutExpired:
        raise UsageError(f"OMP usage timed out after {OMP_TIMEOUT_SECONDS}s", 2) from None
    except OSError as error:
        raise UsageError(f"failed to run OMP: {error}", 2) from error
    if completed.returncode != 0:
        raise UsageError(f"OMP exited with code {completed.returncode}", 2)
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise UsageError(f"OMP produced invalid JSON: {error}", 1) from error
    if not isinstance(payload, dict):
        raise UsageError("OMP JSON payload is not an object", 1)
    reports = payload.get("reports")
    if not isinstance(reports, list):
        raise UsageError("OMP payload has no reports list", 1)
    if reports and not usable_reports(payload):
        raise UsageError("OMP payload has no provider reports", 1)
    return payload


def utc_today() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def to_percent(used) -> float | None:
    if isinstance(used, bool) or not isinstance(used, (int, float)):
        return None
    value = float(used) * 100.0
    return max(0.0, min(100.0, value)) if math.isfinite(value) else None


def bar(percent: float | None) -> str:
    if percent is None:
        return BAR_EMPTY * BAR_CELLS
    filled = round(max(0.0, min(100.0, percent)) / 100 * BAR_CELLS)
    return BAR_FILLED * filled + BAR_EMPTY * (BAR_CELLS - filled)


def status_mark(percent: float | None, status) -> str:
    if status == "exhausted":
        return " 🚫"
    if status == "warning":
        return " ⚠️"
    if status == "unknown" or percent is None:
        return " (unknown)"
    if status == "ok":
        return ""
    if percent >= 100:
        return " 🚫"
    if percent >= WARNING_PERCENT:
        return " ⚠️"
    return ""


def reset_datetime(value) -> datetime | None:
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        seconds = float(value)
        if not math.isfinite(seconds):
            return None
        if seconds > 1_000_000_000_000:
            seconds /= 1000
        try:
            return datetime.fromtimestamp(seconds, tz=timezone.utc)
        except (OSError, OverflowError, ValueError):
            return None
    if isinstance(value, str):
        text = value.strip()
        if text.endswith(("Z", "z")):
            text = text[:-1] + "+00:00"
        try:
            moment = datetime.fromisoformat(text)
        except ValueError:
            return None
        if moment.tzinfo is None:
            moment = moment.replace(tzinfo=timezone.utc)
        return moment.astimezone(timezone.utc)
    return None


def fmt_reset(value) -> str:
    moment = reset_datetime(value)
    if moment is None:
        return ""
    if moment.date() == datetime.now(timezone.utc).date():
        return f"{moment.strftime('%H:%M')} UTC"
    return f"{moment.strftime('%b %d %H:%M')} UTC"


def fmt_reset_estimate(value) -> str:
    moment = reset_datetime(value)
    if moment is None:
        return ""
    seconds = (moment - datetime.now(timezone.utc)).total_seconds()
    if seconds <= 0:
        return "~now"
    if seconds < 3_600:
        count = max(1, math.ceil(seconds / 60))
        unit = "minute" if count == 1 else "minutes"
    elif seconds < 86_400:
        count = math.ceil(seconds / 3_600)
        unit = "hour" if count == 1 else "hours"
    else:
        count = math.ceil(seconds / 86_400)
        unit = "day" if count == 1 else "days"
    return f"~in {count} {unit}"

def limit_reset_key(limit: dict) -> tuple[int, datetime]:
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    moment = reset_datetime(window.get("resetsAt"))
    if moment is None:
        return 1, datetime.max.replace(tzinfo=timezone.utc)
    return 0, moment


def plan_metadata(plan) -> str:
    if isinstance(plan, str) and plan.strip():
        return escape(plan.strip())
    if isinstance(plan, dict):
        for key in ("name", "plan", "id", "title"):
            value = plan.get(key)
            if isinstance(value, str) and value.strip():
                return escape(value.strip())
    return ""
def limit_label(limit: dict) -> str:
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    scope = limit.get("scope")
    scope = scope if isinstance(scope, dict) else {}
    amount = limit.get("amount")
    amount = amount if isinstance(amount, dict) else {}
    label = limit.get("label") or window.get("label") or limit.get("id")
    label_text = str(label) if label else "?"
    additions = []
    tier = scope.get("tier")
    if isinstance(tier, str) and tier.strip() and tier.casefold() not in label_text.casefold():
        additions.append(tier.strip())
    window_label = window.get("label") or scope.get("windowId")
    if isinstance(window_label, str) and window_label.strip():
        window_text = window_label.strip()
        if window_text.casefold() != "quota window" and window_text.casefold() not in label_text.casefold():
            additions.append(window_text)
    unit = amount.get("unit")
    if isinstance(unit, str) and unit in ("requests", "tokens", "credits") and unit not in label_text.casefold():
        additions.append(unit)
    if additions:
        label_text += f" ({', '.join(additions)})"
    return escape(label_text)



def format_limit(limit: dict, label_width: int) -> str:
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    label_text = limit_label(limit)
    amount = limit.get("amount")
    amount = amount if isinstance(amount, dict) else {}
    percent = to_percent(amount.get("usedFraction"))
    percent_text = "?" if percent is None else f"{percent:5.1f}%"
    line = f"{bar(percent)} {percent_text:>6} · {label_text:<{label_width}}"
    raw_reset = window.get("resetsAt")
    when = fmt_reset_estimate(raw_reset)
    if when:
        line += f" · resets {when}"
    line += status_mark(percent, limit.get("status"))
    return f"<code>{line}</code>"



def provider_display(provider: str) -> str:
    known = PROVIDER_DISPLAY_NAMES.get(provider)
    if known:
        return escape(known)
    words = [part.title() for part in provider.split("-") if part]
    return escape(" ".join(words) if words else provider)


def format_message(payload: dict) -> str:
    header = f"<b>OMP usage</b> · {utc_today()}"
    updated = fmt_reset(payload.get("generatedAt"))
    if updated:
        header += f" · last updated {updated}"
    grouped: dict[str, list[dict]] = {}
    for report in usable_reports(payload):
        grouped.setdefault(report["provider"], []).append(report)
    label_width = 0
    for reports in grouped.values():
        for report in reports:
            limits = report.get("limits")
            if not isinstance(limits, list):
                continue
            for limit in limits:
                if isinstance(limit, dict):
                    label_width = max(label_width, len(limit_label(limit)))
    blocks = []
    for provider, reports in grouped.items():
        block = [f"<b>{provider_display(provider)}</b>"]
        for index, report in enumerate(reports, start=1):
            entry = []
            if len(reports) > 1:
                entry.append(f"<i>account {index}</i>")
            metadata = report.get("metadata")
            metadata = metadata if isinstance(metadata, dict) else {}
            plan = plan_metadata(metadata.get("planType"))
            if plan:
                entry.append(f"<i>plan: {plan}</i>")
            limits = report.get("limits")
            if isinstance(limits, list):
                for limit in sorted(
                    (limit for limit in limits if isinstance(limit, dict)),
                    key=limit_reset_key,
                ):
                    entry.append(format_limit(limit, label_width))
            if not entry:
                entry.append("No limits reported.")
            block.extend(entry)
        blocks.append("\n".join(block))
    if not blocks:
        return f"{header}\nNo provider reports."
    return "\n\n".join([header] + blocks)


def plain_image_text(html_text: str) -> str:
    text = re.sub(r"</?[A-Za-z][^>]*>", "", html_text)
    text = unescape(text)
    lines = []
    for raw_line in text.splitlines():
        line = raw_line.replace("\t", "    ")
        line = "".join(char if char.isprintable() else " " for char in line)
        line = line.replace("⚠️", "[!]").replace("🚫", "[X]")
        lines.append(line.rstrip())
    return "\n".join(lines).strip("\n")


def reset_estimate_seconds(line: str) -> int | None:
    match = re.search(r"resets ~in (\d+) (minutes?|hours?|days?)\b", line)
    if match is None:
        return None
    count = int(match.group(1))
    unit = match.group(2)
    if unit.startswith("minute"):
        return count * 60
    if unit.startswith("hour"):
        return count * 3_600
    if unit.startswith("day"):
        return count * 86_400
    return None


def image_line_color(line: str) -> str:
    if not line.startswith((BAR_FILLED, BAR_EMPTY)):
        return IMAGE_TEXT_COLOR
    if "[X]" in line:
        return IMAGE_BAD_COLOR
    if "[!]" in line:
        return IMAGE_WARNING_COLOR
    match = re.search(r"\s(\d+(?:\.\d+)?)%\s·", line)
    if match:
        percent = float(match.group(1))
        if percent >= 100:
            return IMAGE_BAD_COLOR
        if percent >= WARNING_PERCENT:
            return IMAGE_WARNING_COLOR
        reset_seconds = reset_estimate_seconds(line)
        if reset_seconds is not None and reset_seconds <= USE_RESET_SECONDS:
            return IMAGE_USE_COLOR
    if "?" in line:
        return IMAGE_MUTED_COLOR
    return IMAGE_GOOD_COLOR


def ffmpeg_filter_path(path: str) -> str:
    return path.replace("\\", "\\\\").replace(":", "\\:").replace(",", "\\,").replace("'", "\\'")


def render_image(text: str) -> bytes:
    lines = text.splitlines() or [""]
    if not any(lines):
        raise UsageError("usage image has no text", 2)
    longest = max(len(line) for line in lines)
    font_size = 28
    if longest > 70:
        font_size = 24
    if longest > 100:
        font_size = 20
    line_height = font_size + 14
    logo_size = font_size + 8
    logo_content_size = logo_size - 2 * LOGO_INSET
    content_width = longest * font_size * 0.62 + 96
    logo_specs = []
    for index, line in enumerate(lines):
        logo = PROVIDER_LOGOS.get(line)
        if logo:
            logo_filename, invert = logo
            logo_path = LOGO_DIR / logo_filename
            if not logo_path.is_file():
                raise UsageError(f"logo asset not found for {line}: {logo_path}", 2)
            logo_specs.append((index, logo_path, invert))
            content_width = max(
                content_width,
                len(line) * font_size * 0.62 + logo_size + 112,
            )
    width = max(900, int(content_width))
    height = max(180, 72 + len(lines) * line_height)
    if width % 2:
        width += 1
    if height % 2:
        height += 1
    ffmpeg = os.environ.get("FFMPEG_BIN", "ffmpeg")
    font_path = os.environ.get("OMP_USAGE_FONT", DEFAULT_FONT_PATH)
    try:
        with tempfile.TemporaryDirectory(prefix="omp-usage-") as directory:
            drawtext_filters = []
            logo_inputs = []
            logo_overlays = []
            logo_by_index = {
                index: (logo_path, invert)
                for index, logo_path, invert in logo_specs
            }
            for index, line in enumerate(lines):
                if not line:
                    continue
                y = 36 + index * line_height
                line_path = Path(directory) / f"line-{index:03d}.txt"
                line_path.write_text(line, encoding="utf-8")
                text_x = 48
                logo = logo_by_index.get(index)
                if logo:
                    logo_path, invert = logo
                    text_x += logo_size + 16
                    input_index = 1 + len(logo_overlays)
                    logo_inputs.extend(
                        ["-f", "svg_pipe", "-loop", "1", "-i", str(logo_path)]
                    )
                    logo_overlays.append((input_index, y, invert))
                drawtext_filters.append(
                    f"drawtext=fontfile={ffmpeg_filter_path(font_path)}:"
                    f"textfile={ffmpeg_filter_path(str(line_path))}:"
                    f"fontcolor={image_line_color(line)}:fontsize={font_size}:"
                    f"expansion=none:x={text_x}:y={y}"
                )
            if not drawtext_filters:
                raise UsageError("usage image has no text", 2)
            filter_parts = [f"[0:v]{','.join(drawtext_filters)}[base]"]
            last_label = "base"
            for index, (input_index, y, invert) in enumerate(logo_overlays):
                logo_label = f"logo{index}"
                logo_filters = []
                if invert:
                    logo_filters.append("lutrgb=r=negval:g=negval:b=negval")
                logo_filters.extend(
                    [
                        f"scale={logo_content_size}:{logo_content_size}:"
                        "force_original_aspect_ratio=decrease,"
                        f"pad={logo_size}:{logo_size}:(ow-iw)/2:(oh-ih)/2:color=0x00000000,"
                        "format=rgba",
                    ]
                )
                filter_parts.append(
                    f"[{input_index}:v]{','.join(logo_filters)}[{logo_label}]"
                )
                output_label = f"stage{index}"
                overlay_y = y + int(0.6 * font_size - logo_size / 2)
                filter_parts.append(
                    f"[{last_label}][{logo_label}]overlay=x=48:y={overlay_y}:"
                    f"eof_action=repeat:repeatlast=1[{output_label}]"
                )
                last_label = output_label
            filter_parts.append(f"[{last_label}]format=rgb24[out]")
            command = [
                ffmpeg,
                "-hide_banner",
                "-loglevel",
                "error",
                "-y",
                "-f",
                "lavfi",
                "-i",
                f"color=c=0x26263f:s={width}x{height}",
                *logo_inputs,
                "-filter_complex",
                ";".join(filter_parts),
                "-map",
                "[out]",
                "-frames:v",
                "1",
                "-f",
                "image2pipe",
                "-vcodec",
                "png",
                "pipe:1",
            ]
            try:
                completed = subprocess.run(
                    command,
                    capture_output=True,
                    timeout=FFMPEG_TIMEOUT_SECONDS,
                    check=False,
                )
            except FileNotFoundError:
                raise UsageError(f"ffmpeg binary not found: {ffmpeg}", 1) from None
            except subprocess.TimeoutExpired:
                raise UsageError(f"ffmpeg image render timed out after {FFMPEG_TIMEOUT_SECONDS}s", 2) from None
            except OSError as error:
                raise UsageError(f"failed to render usage image: {error}", 2) from error
            if completed.returncode != 0 or not completed.stdout:
                raise UsageError(
                    f"ffmpeg failed to render usage image (exit {completed.returncode})",
                    2,
                )
            return completed.stdout
    except UsageError:
        raise
    except OSError as error:
        raise UsageError(f"failed to prepare usage image: {error}", 2) from error


def load_config() -> dict | None:
    try:
        raw = CLAUDE_CONFIG_PATH.read_text(encoding="utf-8")
    except OSError:
        return None
    config = {}
    for line in raw.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            config[key.strip()] = value.strip()
    token = config.get("TELEGRAM_BOT_TOKEN")
    chat_id = config.get("TELEGRAM_CHAT_ID")
    if isinstance(token, str) and token and isinstance(chat_id, str) and chat_id:
        return {"bot_token": token, "chat_id": chat_id}
    return None


def credentials(config: dict | None) -> tuple[str, object] | None:
    if not isinstance(config, dict):
        return None
    token = config.get("bot_token")
    chat_id = config.get("chat_id")
    if not isinstance(token, str) or not token or chat_id in (None, ""):
        return None
    return token, chat_id


def load_state() -> dict:
    try:
        raw = CODEX_STATE_PATH.read_text(encoding="utf-8")
    except OSError:
        return {}
    try:
        state = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return state if isinstance(state, dict) else {}


def save_state(state: dict) -> None:
    CODEX_STATE_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(CODEX_STATE_PATH.parent, 0o700)
    descriptor, temporary = tempfile.mkstemp(
        dir=CODEX_STATE_PATH.parent, prefix=".state-", suffix=".tmp"
    )
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(state, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, CODEX_STATE_PATH)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def tg_call(bot_token: str, method: str, params: dict) -> dict:
    request = urllib.request.Request(
        f"{TELEGRAM_API_BASE}/bot{bot_token}/{method}",
        data=json.dumps(params).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TELEGRAM_TIMEOUT_SECONDS) as response:
        body = response.read()
    try:
        payload = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise TelegramError(f"Telegram {method} returned invalid JSON: {error}") from error
    if not isinstance(payload, dict) or payload.get("ok") is not True:
        description = payload.get("description", "unknown error") if isinstance(payload, dict) else "malformed response"
        raise TelegramError(f"Telegram {method} failed: {description}")
    return payload


def multipart_form(
    fields: dict[str, object],
    file_field: str,
    filename: str,
    media: bytes,
) -> tuple[bytes, str]:
    boundary = f"----omp-usage-{uuid4().hex}"
    parts = []
    for name, value in fields.items():
        parts.extend(
            [
                f"--{boundary}\r\n".encode("ascii"),
                f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode("ascii"),
                str(value).encode("utf-8"),
                b"\r\n",
            ]
        )
    parts.extend(
        [
            f"--{boundary}\r\n".encode("ascii"),
            (
                f'Content-Disposition: form-data; name="{file_field}"; '
                f'filename="{filename}"\r\n'
            ).encode("ascii"),
            b"Content-Type: image/png\r\n\r\n",
            media,
            b"\r\n",
            f"--{boundary}--\r\n".encode("ascii"),
        ]
    )
    return b"".join(parts), boundary


def tg_upload(
    bot_token: str,
    method: str,
    fields: dict[str, object],
    file_field: str,
    filename: str,
    media: bytes,
) -> dict:
    body, boundary = multipart_form(fields, file_field, filename, media)
    request = urllib.request.Request(
        f"{TELEGRAM_API_BASE}/bot{bot_token}/{method}",
        data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TELEGRAM_TIMEOUT_SECONDS) as response:
        response_body = response.read()
    try:
        payload = json.loads(response_body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise TelegramError(f"Telegram {method} returned invalid JSON: {error}") from error
    if not isinstance(payload, dict) or payload.get("ok") is not True:
        description = (
            payload.get("description", "unknown error")
            if isinstance(payload, dict)
            else "malformed response"
        )
        raise TelegramError(f"Telegram {method} failed: {description}")
    return payload


def tg_send_photo(config: dict, image: bytes) -> int:
    payload = tg_upload(
        config["bot_token"],
        "sendPhoto",
        {"chat_id": config["chat_id"]},
        "photo",
        "omp-usage.png",
        image,
    )
    result = payload.get("result")
    result = result if isinstance(result, dict) else {}
    message_id = result.get("message_id")
    if not isinstance(message_id, int):
        raise TelegramError("Telegram sendPhoto returned no message_id")
    return message_id


def tg_edit_photo(config: dict, message_id: int, image: bytes) -> None:
    tg_upload(
        config["bot_token"],
        "editMessageMedia",
        {
            "chat_id": config["chat_id"],
            "message_id": message_id,
            "media": json.dumps(
                {"type": "photo", "media": "attach://photo"},
                separators=(",", ":"),
            ),
        },
        "photo",
        "omp-usage.png",
        image,
    )


def tg_pin(config: dict, message_id: int) -> None:
    tg_call(
        config["bot_token"],
        "pinChatMessage",
        {
            "chat_id": config["chat_id"],
            "message_id": message_id,
            "disable_notification": True,
        },
    )


def edit_failure_action(description: str) -> str:
    lowered = description.casefold()
    if "message is not modified" in lowered:
        return "ok"
    if "message to edit not found" in lowered:
        return "replace"
    return "fail"


def update_pinned(config: dict, image: bytes, state_key: str) -> bool:
    state = load_state()
    message_id = state.get(state_key)
    if isinstance(message_id, int):
        try:
            tg_edit_photo(config, message_id, image)
        except urllib.error.HTTPError as error:
            try:
                description = error.read().decode("utf-8", "replace")
            except (AttributeError, OSError, ValueError):
                description = ""
            action = edit_failure_action(description)
            if action == "ok":
                return True
            if action != "replace":
                return False
        except TelegramError as error:
            action = edit_failure_action(str(error))
            if action == "ok":
                return True
            if action != "replace":
                return False
        except (OSError, TimeoutError):
            return False
        else:
            try:
                tg_pin(config, message_id)
            except (urllib.error.HTTPError, OSError, TimeoutError, TelegramError):
                return False
            return True
    try:
        new_message_id = tg_send_photo(config, image)
    except (OSError, TimeoutError, TelegramError):
        return False
    state[state_key] = new_message_id
    try:
        save_state(state)
    except OSError:
        return False
    try:
        tg_pin(config, new_message_id)
    except (urllib.error.HTTPError, OSError, TimeoutError, TelegramError):
        return False
    return True


def build_image() -> tuple[bytes, int]:
    try:
        payload = run_omp_usage()
    except UsageError as error:
        if error.exit_code == 1:
            raise
        warning = (
            f"<b>OMP usage</b> · {utc_today()} · "
            f"last updated {datetime.now(timezone.utc).strftime('%H:%M UTC')}\n"
            f"⚠️ OMP usage unavailable: {escape(str(error))}"
        )
        try:
            return render_image(plain_image_text(warning)), error.exit_code
        except UsageError:
            raise
        except (TypeError, ValueError, KeyError, AttributeError, OSError) as render_error:
            raise UsageError(f"failed to render usage image: {render_error}", 2) from render_error
    try:
        text = format_message(payload)
        return render_image(plain_image_text(text)), 0
    except UsageError:
        raise
    except (TypeError, ValueError, KeyError, AttributeError, OSError) as error:
        raise UsageError(f"failed to render usage image: {error}", 2) from error

def token_display_name(provider: str) -> str:
    known = PROVIDER_DISPLAY_NAMES.get(provider)
    if known:
        return known
    words = [part for part in provider.split("-") if part]
    return " ".join(word[:1].upper() + word[1:] for word in words) if words else provider


def token_provider_color(provider: str) -> str:
    known = TOKEN_PROVIDER_COLORS.get(provider)
    if known:
        return known
    digest = hashlib.sha256(provider.encode("utf-8")).digest()
    hue = int.from_bytes(digest[:2], "big") / 65536.0
    red, green, blue = colorsys.hsv_to_rgb(hue, 0.5, 0.9)
    return f"0x{round(red * 255):02x}{round(green * 255):02x}{round(blue * 255):02x}"


def valid_ssh_host(value: object) -> str | None:
    if not isinstance(value, str) or not value:
        return None
    if value.startswith("-") or any(char.isspace() for char in value):
        return None
    return value


def check_ssh_host() -> str | None:
    return valid_ssh_host(os.environ.get(TOKEN_SSH_HOST_ENV))


def remote_token_collection_source() -> bytes:
    try:
        return TOKEN_USAGE_PATH.read_bytes()
    except OSError as error:
        raise UsageError(f"token usage collector unreadable: {error}", 1) from error


def local_token_collection(start_ms: int, end_ms: int) -> tuple[str, dict | None, list[str]]:
    try:
        collection = token_usage.collect_usage(Path.home() / ".omp", start_ms, end_ms)
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        return "WSL", None, ["WSL unavailable: collector failure"]
    if not isinstance(collection, dict):
        return "WSL", None, ["WSL unavailable: invalid collection"]
    return "WSL", collection, []


def remote_token_collection(host: str, source: bytes, start_ms: int, end_ms: int) -> tuple[str, dict | None, list[str]]:
    command = [
        TOKEN_SSH_BINARY,
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "ConnectTimeout=10",
        "-o",
        "ServerAliveInterval=10",
        "-o",
        "ServerAliveCountMax=2",
        host,
        TOKEN_SSH_PYTHON,
        "-",
        "--start-ms",
        str(start_ms),
        "--end-ms",
        str(end_ms),
    ]
    try:
        completed = subprocess.run(
            command,
            input=source,
            capture_output=True,
            timeout=TOKEN_SSH_TIMEOUT_SECONDS,
            check=False,
        )
    except FileNotFoundError:
        return "mini-1", None, ["mini-1 unavailable: ssh binary not found"]
    except subprocess.TimeoutExpired:
        return "mini-1", None, ["mini-1 unavailable: ssh timed out"]
    except OSError as error:
        return "mini-1", None, [f"mini-1 unavailable: {error}"]
    stdout = completed.stdout or b""
    if completed.returncode == 255:
        print("codex-usage-check: token ssh connection failed", file=sys.stderr)
        return "mini-1", None, ["mini-1 unavailable: ssh connection failed"]
    if completed.returncode not in (0, 2):
        print(f"codex-usage-check: token ssh exited {completed.returncode}", file=sys.stderr)
        return "mini-1", None, [f"mini-1 unavailable: remote collector exited {completed.returncode}"]
    try:
        collection = json.loads(stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        print("codex-usage-check: token ssh returned invalid JSON", file=sys.stderr)
        return "mini-1", None, ["mini-1 unavailable: invalid remote collection"]
    if not isinstance(collection, dict):
        print("codex-usage-check: token ssh returned invalid collection", file=sys.stderr)
        return "mini-1", None, ["mini-1 unavailable: invalid remote collection"]
    if completed.returncode == 2 and not collection.get("issues"):
        print("codex-usage-check: token ssh returned inconsistent collection", file=sys.stderr)
        return "mini-1", None, ["mini-1 unavailable: invalid remote collection"]
    return "mini-1", collection, []


def collect_token_snapshot(now_ms: int) -> token_usage.TokenSnapshot:
    require_token_usage()
    end_ms = now_ms
    start_ms = (end_ms // TOKEN_DAY_MS - TOKEN_LOOKBACK_DAYS + 1) * TOKEN_DAY_MS
    collections: list[tuple[str, dict]] = []
    snapshot_issues: list[str] = []
    label, local_collection, local_issues = local_token_collection(start_ms, end_ms)
    snapshot_issues.extend(local_issues)
    if local_collection is not None:
        collections.append((label, local_collection))
    host = check_ssh_host()
    if host is None:
        snapshot_issues.append("mini-1 unconfigured")
    else:
        try:
            source = remote_token_collection_source()
        except UsageError as error:
            print(f"codex-usage-check: {error}", file=sys.stderr)
            snapshot_issues.append("mini-1 unavailable: collector unreadable")
            source = None
        if source is not None:
            label, remote_collection, remote_issues = remote_token_collection(host, source, start_ms, end_ms)
            snapshot_issues.extend(remote_issues)
            if remote_collection is not None:
                collections.append((label, remote_collection))
    snapshot = token_usage.merge_usage(collections, start_ms, end_ms)
    if snapshot_issues:
        snapshot["issues"] = [*snapshot_issues, *snapshot.get("issues", [])]
    return snapshot


def format_compact_tokens(tokens: int) -> str:
    if tokens < 1000:
        return str(tokens)
    if tokens < 1_000_000:
        value = tokens / 1000
        text = f"{value:.1f}".rstrip("0").rstrip(".")
        return f"{text}K"
    if tokens < 1_000_000_000:
        value = tokens / 1_000_000
        text = f"{value:.1f}".rstrip("0").rstrip(".")
        return f"{text}M"
    value = tokens / 1_000_000_000
    text = f"{value:.1f}".rstrip("0").rstrip(".")
    return f"{text}B"


def token_axis_max(maximum: int) -> int:
    if maximum <= 0:
        return 1
    magnitude = 10 ** (len(str(maximum)) - 1)
    for multiple in (1, 2, 5, 10):
        ceiling = multiple * magnitude
        if ceiling >= maximum:
            return ceiling
    return 10 * magnitude


def format_price_label(provider: dict, incomplete: bool) -> str:
    tokens = provider.get("tokens", 0)
    cost = provider.get("estimated_usd", 0.0)
    unpriced = provider.get("unpriced_records", 0)
    prefix = "Known " if incomplete or unpriced else "Est. "
    if unpriced and tokens > 0 and (not isinstance(cost, (int, float)) or cost <= 0):
        return "Price unavailable"
    if tokens <= 0:
        return "$0.00"
    if unpriced:
        return f"{prefix}${cost:,.2f} + unpriced"
    if cost > 0 and cost < 0.01:
        return f"{prefix}<$0.01"
    return f"{prefix}${cost:,.2f}"


def split_provider_label(label: str) -> list[str]:
    words = label.split()
    if not words:
        return [label]
    lines: list[str] = []
    current = ""
    for word in words:
        candidate = f"{current} {word}".strip()
        if current and len(candidate) > 12:
            lines.append(current)
            current = word
        else:
            current = candidate
    if current:
        lines.append(current)
    if len(lines) > 3:
        tail = " ".join(lines[2:])
        lines = [*lines[:2], f"{tail[:11]}…"]
    return [line if len(line) <= 16 else f"{line[:15]}…" for line in lines]



def render_token_chart(snapshot: token_usage.TokenSnapshot) -> bytes:
    providers = snapshot.get("providers", [])
    if not providers:
        raise UsageError("token chart has no providers", 2)
    days = snapshot.get("days", [])
    if not days:
        raise UsageError("token chart has no days", 2)
    count = len(days)
    width = max(1400, 144 + 200 * count)
    height = 960
    if width % 2:
        width += 1
    if height % 2:
        height += 1
    left, right, top, baseline = 104, 40, 320, 700
    plot_width = width - left - right
    plot_height = baseline - top
    day_totals = [int(day.get("tokens", 0)) for day in days]
    axis_max = token_axis_max(max(day_totals) if day_totals else 0)
    slot = plot_width / count
    bar_width = int(min(96, slot * 0.55))
    ffmpeg = os.environ.get("FFMPEG_BIN", "ffmpeg")
    font_path = os.environ.get("OMP_USAGE_FONT", DEFAULT_FONT_PATH)
    start = datetime.fromtimestamp(snapshot["start_ms"] / 1000, tz=timezone.utc)
    end = datetime.fromtimestamp(snapshot["end_ms"] / 1000, tz=timezone.utc)
    updated = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    sources_ok = snapshot.get("sources_ok", [])
    issues = snapshot.get("issues", [])
    incomplete = bool(issues)
    try:
        with tempfile.TemporaryDirectory(prefix="omp-tokens-") as directory:
            drawboxes: list[str] = []
            drawtexts: list[str] = []

            def text_filter(text: str, x: object, y: object, size: int, color: str) -> str:
                path = Path(directory) / f"token-{len(drawtexts):03d}.txt"
                path.write_text(text, encoding="utf-8")
                return (
                    f"drawtext=fontfile={ffmpeg_filter_path(font_path)}:"
                    f"textfile={ffmpeg_filter_path(str(path))}:"
                    f"fontcolor={color}:fontsize={size}:"
                    f"expansion=none:x={x}:y={y}"
                )

            drawtexts.append(text_filter("OMP token usage \u00b7 Last 7 days", 48, 36, 34, IMAGE_TEXT_COLOR))
            drawtexts.append(text_filter(f"{start.strftime('%Y-%m-%d %H:%M UTC')} to {end.strftime('%Y-%m-%d %H:%M UTC')}", 48, 84, 22, IMAGE_MUTED_COLOR))
            if incomplete:
                failed = []
                for issue in issues:
                    head = issue.split(":")[0]
                    if head and head not in failed:
                        failed.append(head)
                available = " + ".join(sources_ok) if sources_ok else "no sources"
                drawtexts.append(text_filter(f"INCOMPLETE \u00b7 {available}", 48, 118, 22, IMAGE_WARNING_COLOR))
                failure_text = "; ".join(failed)
                if len(failure_text) > 90:
                    failure_text = f"{failure_text[:89]}\u2026"
                if failure_text:
                    drawtexts.append(text_filter(failure_text, 48, 148, 20, IMAGE_WARNING_COLOR))
            else:
                drawtexts.append(text_filter(f"WSL + mini-1 \u00b7 Updated {updated}", 48, 118, 22, IMAGE_MUTED_COLOR))
            per_row = 4 if len(providers) > 4 else len(providers)
            for legend_index, provider in enumerate(providers):
                row, col = divmod(legend_index, per_row)
                legend_x = 48 + col * 360
                legend_y = 190 + row * 36
                color = token_provider_color(provider.get("provider", ""))
                drawboxes.append(f"drawbox=x={legend_x}:y={legend_y + 4}:w=28:h=16:c={color}:t=fill")
                drawtexts.append(text_filter(token_display_name(provider.get("provider", "")), legend_x + 38, legend_y, 20, IMAGE_TEXT_COLOR))
            if incomplete and not sources_ok:
                drawtexts.append(text_filter("Usage unavailable", 48, 262, 26, IMAGE_WARNING_COLOR))
            for level in range(6):
                value = axis_max * level // 5
                y = baseline - round(plot_height * level / 5)
                drawboxes.append(f"drawbox=x={left}:y={y}:w={plot_width}:h=1:c=0x3b3b58:t=fill")
                drawtexts.append(text_filter(format_compact_tokens(value), 8, y - 12, 20, IMAGE_MUTED_COLOR))
            drawboxes.append(f"drawbox=x={left}:y={baseline}:w={plot_width}:h=2:c=0x8b8ba3:t=fill")
            point_coords: list[tuple[int, int]] = []
            for index, day in enumerate(days):
                center = left + slot * index + slot / 2
                bar_x = int(center - bar_width / 2)
                day_providers = day.get("providers", [])
                totals_by_name = {str(item.get("provider", "")): int(item.get("tokens", 0)) for item in day_providers}
                stacked = baseline
                for provider in providers:
                    name = str(provider.get("provider", ""))
                    seg_tokens = max(0, totals_by_name.get(name, 0))
                    seg_height = round(plot_height * seg_tokens / axis_max) if axis_max else 0
                    if seg_height <= 0:
                        continue
                    seg_y = stacked - seg_height
                    drawboxes.append(f"drawbox=x={bar_x}:y={seg_y}:w={bar_width}:h={seg_height}:c={token_provider_color(name)}:t=fill")
                    stacked = seg_y
                total = day_totals[index]
                point_y = baseline - (round(plot_height * total / axis_max) if axis_max else 0)
                point_x = int(center)
                point_coords.append((point_x, point_y))
                if total <= 0:
                    drawboxes.append(f"drawbox=x={bar_x}:y={baseline - 4}:w={bar_width}:h=4:c=0x8b8ba3:t=fill")
                token_text = f"{total:,} tokens"
                price_text = format_price_label(day, incomplete)
                size = 18
                while size > 13 and (len(token_text) * size * 0.62 > slot - 8 or len(price_text) * size * 0.62 > slot - 8):
                    size -= 1
                value_y = max(296, point_y - 58)
                drawtexts.append(text_filter(token_text, f"({center})-tw/2", value_y, size, IMAGE_TEXT_COLOR))
                drawtexts.append(text_filter(price_text, f"({center})-tw/2", value_y + size + 6, size, IMAGE_MUTED_COLOR))
                day_start = datetime.fromtimestamp(int(day.get("start_ms", snapshot["start_ms"])) / 1000, tz=timezone.utc)
                drawtexts.append(text_filter(day_start.strftime("%b %d"), f"({center})-tw/2", baseline + 18, 20, IMAGE_TEXT_COLOR))
            line_color = "0xffd166"
            for first, second in zip(point_coords, point_coords[1:]):
                steps = max(abs(second[0] - first[0]), abs(second[1] - first[1]), 1) // 3
                for step in range(int(steps) + 1):
                    fraction = step / steps if steps else 0
                    line_x = round(first[0] + (second[0] - first[0]) * fraction) - 2
                    line_y = round(first[1] + (second[1] - first[1]) * fraction) - 2
                    drawboxes.append(f"drawbox=x={line_x}:y={line_y}:w=4:h=4:c={line_color}:t=fill")
            for point_x, point_y in point_coords:
                drawboxes.append(f"drawbox=x={point_x - 5}:y={point_y - 5}:w=10:h=10:c={line_color}:t=fill")
            total_tokens = sum(int(provider.get("tokens", 0)) for provider in providers)
            total_cost = math.fsum(float(provider.get("estimated_usd", 0.0)) for provider in providers)
            total_unpriced = sum(int(provider.get("unpriced_records", 0)) for provider in providers)
            aggregate = "Observed total" if incomplete else "Total"
            total_text = f"{aggregate}: {total_tokens:,} tokens \u00b7 {format_price_label({'tokens': total_tokens, 'estimated_usd': total_cost, 'unpriced_records': total_unpriced}, incomplete)}"
            drawtexts.append(text_filter(total_text, 48, 820, 22, IMAGE_TEXT_COLOR))
            drawtexts.append(text_filter("Reported OMP tokens \u00b7 Recorded USD estimates, not subscription charges", 48, 852, 20, IMAGE_MUTED_COLOR))
            drawtexts.append(text_filter("Antigravity includes AGY CLI; unavailable prices are not counted as free.", 48, 880, 20, IMAGE_MUTED_COLOR))
            command = [
                ffmpeg,
                "-hide_banner",
                "-loglevel",
                "error",
                "-y",
                "-f",
                "lavfi",
                "-i",
                f"color=c=0x26263f:s={width}x{height}",
                "-filter_complex",
                f"[0:v]{','.join([*drawboxes, *drawtexts])}[out]",
                "-map",
                "[out]",
                "-frames:v",
                "1",
                "-f",
                "image2pipe",
                "-vcodec",
                "png",
                "pipe:1",
            ]
            try:
                completed = subprocess.run(
                    command,
                    capture_output=True,
                    timeout=FFMPEG_TIMEOUT_SECONDS,
                    check=False,
                )
            except FileNotFoundError:
                raise UsageError(f"ffmpeg binary not found: {ffmpeg}", 1) from None
            except subprocess.TimeoutExpired:
                raise UsageError(f"ffmpeg token render timed out after {FFMPEG_TIMEOUT_SECONDS}s", 2) from None
            except OSError as error:
                raise UsageError(f"failed to render token chart: {error}", 2) from error
            if completed.returncode != 0 or not completed.stdout:
                raise UsageError(
                    f"ffmpeg failed to render token chart (exit {completed.returncode})",
                    2,
                )
            return completed.stdout
    except UsageError:
        raise
    except OSError as error:
        raise UsageError(f"failed to prepare token chart: {error}", 2) from error


def build_token_image(now_ms: int | None = None) -> tuple[bytes, int]:
    if now_ms is None:
        now_ms = time.time_ns() // 1_000_000
    snapshot = collect_token_snapshot(now_ms)
    try:
        image = render_token_chart(snapshot)
    except UsageError:
        raise
    except (TypeError, ValueError, KeyError, AttributeError, OSError) as error:
        raise UsageError(f"failed to render token chart: {error}", 2) from error
    return image, 2 if snapshot.get("issues") else 0


def publish_images(config: dict) -> int:
    status = 0
    try:
        limits_image, limits_code = build_image()
    except UsageError as error:
        limits_image, limits_code = None, fail(error)
    else:
        if not update_pinned(config, limits_image, LIMITS_STATE_KEY):
            print("codex-usage-check: failed to update the limits Telegram message", file=sys.stderr)
            limits_code = 2
    try:
        token_image, token_code = build_token_image()
    except UsageError as error:
        token_image, token_code = None, fail(error)
    else:
        if not update_pinned(config, token_image, TOKENS_STATE_KEY):
            print("codex-usage-check: failed to update the token Telegram message", file=sys.stderr)
            token_code = 2
    for code in (limits_code, token_code):
        if code == 1:
            return 1
        if code == 2:
            status = 2
    return status


def fail(error: Exception) -> int:
    print(f"codex-usage-check: {error}", file=sys.stderr)
    return getattr(error, "exit_code", 2)


def run_json() -> int:
    try:
        payload = run_omp_usage()
    except UsageError as error:
        return fail(error)
    print(json.dumps(payload, indent=2))
    return 0


def run_telegram() -> int:
    config = load_config()
    if credentials(config) is None:
        print(
            "codex-usage-check: no Claude Telegram config; run: claude-usage-check --setup-telegram",
            file=sys.stderr,
        )
        return 1
    return publish_images(config)


def setup_telegram() -> int:
    config = load_config()
    if credentials(config) is None:
        print(
            "codex-usage-check: no Claude Telegram config found; "
            "run: claude-usage-check --setup-telegram first",
            file=sys.stderr,
        )
        return 1
    try:
        me = tg_call(config["bot_token"], "getMe", {})
    except urllib.error.HTTPError as error:
        print(
            f"codex-usage-check: Telegram rejected getMe (HTTP {error.code}); "
            "fix the Claude config",
            file=sys.stderr,
        )
        return 1
    except (OSError, TimeoutError, TelegramError) as error:
        return fail(error)
    result = me.get("result")
    result = result if isinstance(result, dict) else {}
    bot_username = result.get("username") or "unknown"
    code = publish_images(config)
    print(f"Telegram bot @{bot_username} verified; OMP provider usage and token chart pinned in the Claude chat.")
    return code


def main(argv: list[str]) -> int:
    selected = [flag for flag in ("--setup-telegram", "--telegram") if flag in argv]
    unknown = [arg for arg in argv if arg.startswith("-") and arg not in selected]
    if unknown:
        print(f"codex-usage-check: unknown argument: {unknown[0]}", file=sys.stderr)
        return 1
    if len(selected) > 1:
        print("codex-usage-check: choose either --setup-telegram or --telegram", file=sys.stderr)
        return 1
    if "--setup-telegram" in selected:
        return setup_telegram()
    if "--telegram" in selected:
        return run_telegram()
    return run_json()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
