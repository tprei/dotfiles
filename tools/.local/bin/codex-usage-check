    import dashboard
except ImportError as error:
    dashboard = None
    DASHBOARD_IMPORT_ERROR = error
else:
    DASHBOARD_IMPORT_ERROR = None


def require_token_usage():
    if token_usage is None:
        raise UsageError("token usage collector not available", 1) from TOKEN_USAGE_IMPORT_ERROR
    return token_usage


def require_usage_history():
    if usage_history is None:
        raise UsageError("usage history collector not available", 1) from USAGE_HISTORY_IMPORT_ERROR
    return usage_history


def require_activity_usage():
    if activity_usage is None:
        raise UsageError("activity collector not available", 1) from ACTIVITY_IMPORT_ERROR
    return activity_usage


def require_dashboard():
    if dashboard is None:
        raise UsageError("dashboard renderer not available", 1) from DASHBOARD_IMPORT_ERROR
    return dashboard


def usable_report(report) -> bool:
    if not isinstance(report, dict):
        return False
    provider = report.get("provider")
    return isinstance(provider, str) and bool(provider.strip())


def usable_reports(payload: dict) -> list[dict]:
    reports = payload.get("reports")
    if not isinstance(reports, list):
        return []
    return [report for report in reports if usable_report(report)]


def run_omp_usage() -> dict:
    command = [os.environ.get("OMP_BIN", "omp"), "usage", "--json", "--redact"]
    try:
        completed = subprocess.run(
            command, capture_output=True, text=True, timeout=OMP_TIMEOUT_SECONDS, check=False
        )
    except FileNotFoundError:
        raise UsageError(f"OMP binary not found: {command[0]}", 1) from None
    except subprocess.TimeoutExpired:
        raise UsageError(f"OMP usage timed out after {OMP_TIMEOUT_SECONDS}s", 2) from None
    except OSError as error:
        raise UsageError(f"failed to run OMP: {error}", 2) from error
    if completed.returncode != 0:
        raise UsageError(f"OMP exited with code {completed.returncode}", 2)
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise UsageError(f"OMP produced invalid JSON: {error}", 1) from error
    if not isinstance(payload, dict):
        raise UsageError("OMP JSON payload is not an object", 1)
    reports = payload.get("reports")
    if not isinstance(reports, list):
        raise UsageError("OMP payload has no reports list", 1)
    if reports and not usable_reports(payload):
        raise UsageError("OMP payload has no provider reports", 1)
    return payload


def to_percent(used) -> float | None:
    if isinstance(used, bool) or not isinstance(used, (int, float)):
        return None
    value = float(used) * 100.0
    return max(0.0, min(100.0, value)) if math.isfinite(value) else None


def reset_datetime(value) -> datetime | None:
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        seconds = float(value)
        if not math.isfinite(seconds):
            return None
        if seconds > 1_000_000_000_000:
            seconds /= 1000
        try:
            return datetime.fromtimestamp(seconds, tz=timezone.utc)
        except (OSError, OverflowError, ValueError):
            return None
    if isinstance(value, str):
        text = value.strip()
        if text.endswith(("Z", "z")):
            text = text[:-1] + "+00:00"
        try:
            moment = datetime.fromisoformat(text)
        except ValueError:
            return None
        if moment.tzinfo is None:
            moment = moment.replace(tzinfo=timezone.utc)
        return moment.astimezone(timezone.utc)
    return None


def fmt_reset(value) -> str:
    moment = reset_datetime(value)
    if moment is None:
        return ""
    if moment.date() == datetime.now(timezone.utc).date():
        return f"{moment.strftime('%H:%M')} UTC"
    return f"{moment.strftime('%b %d %H:%M')} UTC"


def fmt_duration(ms: int) -> str:
    seconds = ms / 1000
    if seconds <= 0:
        return "~now"
    if seconds < 3_600:
        count = max(1, math.ceil(seconds / 60))
        unit = "minute" if count == 1 else "minutes"
    elif seconds < 86_400:
        count = math.ceil(seconds / 3_600)
        unit = "hour" if count == 1 else "hours"
    else:
        count = math.ceil(seconds / 86_400)
        unit = "day" if count == 1 else "days"
    return f"~in {count} {unit}"


def fmt_reset_estimate(value) -> str:
    moment = reset_datetime(value)
    if moment is None:
        return ""
    diff_ms = int((moment - datetime.now(timezone.utc)).total_seconds() * 1000)
    return fmt_duration(diff_ms)


def limit_reset_key(limit: dict) -> tuple[int, datetime]:
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    moment = reset_datetime(window.get("resetsAt"))
    if moment is None:
        return 1, datetime.max.replace(tzinfo=timezone.utc)
    return 0, moment


def plan_metadata(plan) -> str:
    if isinstance(plan, str) and plan.strip():
        return plan.strip()
    if isinstance(plan, dict):
        for key in ("name", "plan", "id", "title"):
            value = plan.get(key)
            if isinstance(value, str) and value.strip():
                return value.strip()
    return ""


def limit_label(limit: dict) -> str:
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    scope = limit.get("scope")
    scope = scope if isinstance(scope, dict) else {}
    amount = limit.get("amount")
    amount = amount if isinstance(amount, dict) else {}
    label = limit.get("label") or window.get("label") or limit.get("id")
    label_text = str(label) if label else "?"
    additions = []
    tier = scope.get("tier")
    if isinstance(tier, str) and tier.strip() and tier.casefold() not in label_text.casefold():
        additions.append(tier.strip())
    window_label = window.get("label") or scope.get("windowId")
    if isinstance(window_label, str) and window_label.strip():
        window_text = window_label.strip()
        if window_text.casefold() != "quota window" and window_text.casefold() not in label_text.casefold():
            additions.append(window_text)
    unit = amount.get("unit")
    if isinstance(unit, str) and unit in ("requests", "tokens", "credits") and unit not in label_text.casefold():
        additions.append(unit)
    if additions:
        label_text += f" ({', '.join(additions)})"
    return label_text


def provider_display(provider: str) -> str:
    known = PROVIDER_DISPLAY_NAMES.get(provider)
    if known:
        return escape(known)
    words = [part.title() for part in provider.split("-") if part]
    return escape(" ".join(words) if words else provider)


FORECAST_PROVIDERS = ("openai-codex", "anthropic", "zai", "opencode-go")
SHORT_WINDOW_MS = 6 * 3_600_000
SHORT_LOOKBACK_MS = 3 * 3_600_000
LONG_LOOKBACK_MS = 24 * 3_600_000
MIN_RATE_SPAN_MS = 3_600_000
RESET_DROP = 0.02
HOT_FRACTION = 0.85
SPARE_FRACTION = 0.50
COUPLED_PAIR_TOLERANCE_MS = 2 * 60_000
COUPLED_MIN_INTERVAL_GAIN = 0.02
COUPLED_MIN_TOTAL_GAIN = 0.30
COUPLED_MAX_RATIO = 1.0
COUPLED_LONG_WINDOW_MS = 24 * 3_600_000
COUPLED_RATIO_EPSILON = 1e-9


class Forecast(TypedDict):
    provider: str
    limit_id: str
    label: str
    used: float | None
    resets_at_ms: int | None
    window_ms: int | None
    rate_per_hour: float | None
    projected: float | None
    exhaust_in_ms: int | None
    verdict: str
    coupled_limit_id: str | None
    coupled_window_ms: int | None
    coupled_ratio: float | None
    coupled_burn: float | None
    coupled_room: float | None
    spark: list[float | None]


def history_series(snapshot: dict, provider: str, limit_id: str) -> list[tuple[int, float]]:
    samples = snapshot.get("samples")
    if not isinstance(samples, list):
        return []
    highest: dict[int, float] = {}
    for sample in samples:
        if not isinstance(sample, dict):
            continue
        if sample.get("provider") != provider or sample.get("limit_id") != limit_id:
            continue
        recorded_at = sample.get("recorded_at_ms")
        used_fraction = sample.get("used_fraction")
        if not isinstance(recorded_at, int) or isinstance(recorded_at, bool):
            continue
        if not isinstance(used_fraction, (int, float)) or isinstance(used_fraction, bool):
            continue
        fraction = float(used_fraction)
        previous = highest.get(recorded_at)
        if previous is None or fraction > previous:
            highest[recorded_at] = fraction
    return sorted(highest.items())


def burn_rate(series: list[tuple[int, float]], now_ms: int, used: float, lookback_ms: int) -> float | None:
    cutoff = now_ms - lookback_ms
    points = [point for point in series if cutoff <= point[0] <= now_ms]
    points.append((now_ms, used))
    start_index = 0
    for index in range(len(points) - 1):
        if points[index + 1][1] < points[index][1] - RESET_DROP:
            start_index = index + 1
    remaining = points[start_index:]
    first_time, first_fraction = remaining[0]
    span = now_ms - first_time
    if span < MIN_RATE_SPAN_MS:
        return None
    return max(0.0, (used - first_fraction) / (span / 3_600_000))


def spark_buckets(series: list[tuple[int, float]], now_ms: int, buckets: int = 48) -> list[float | None]:
    result: list[float | None] = []
    hour_ms = 3_600_000
    for i in range(buckets):
        start = now_ms - (buckets - i) * hour_ms
        end = now_ms - (buckets - i - 1) * hour_ms
        in_bucket = [fraction for recorded_at, fraction in series if start <= recorded_at < end]
        result.append(in_bucket[-1] if in_bucket else None)
    return result


def pair_series(
    series_a: list[tuple[int, float]], series_b: list[tuple[int, float]], tolerance_ms: int
) -> list[tuple[int, float, float]]:
    """Zip two sorted series into nearest-timestamp (time, fraction_a, fraction_b) pairs within tolerance."""
    pairs: list[tuple[int, float, float]] = []
    index_a = index_b = 0
    while index_a < len(series_a) and index_b < len(series_b):
        time_a, fraction_a = series_a[index_a]
        time_b, fraction_b = series_b[index_b]
        if abs(time_a - time_b) <= tolerance_ms:
            next_time_b = series_b[index_b + 1][0] if index_b + 1 < len(series_b) else None
            next_time_a = series_a[index_a + 1][0] if index_a + 1 < len(series_a) else None
            if next_time_b is not None and abs(time_a - next_time_b) < abs(time_a - time_b):
                index_b += 1
                continue
            if next_time_a is not None and abs(next_time_a - time_b) < abs(time_a - time_b):
                index_a += 1
                continue
            pairs.append((time_a, fraction_a, fraction_b))
            index_a += 1
            index_b += 1
        elif time_a < time_b:
            index_a += 1
        else:
            index_b += 1
    return pairs


def coupled_gain_ratio(
    short_series: list[tuple[int, float]],
    long_series: list[tuple[int, float]],
    short_window_ms: int,
) -> tuple[float | None, float]:
    """Return (long-fraction gain per short-fraction gain, pooled short gain); ratio is None without enough rising history."""
    pairs = pair_series(short_series, long_series, COUPLED_PAIR_TOLERANCE_MS)
    total_short = 0.0
    total_long = 0.0
    for (start_time, short_start, long_start), (end_time, short_end, long_end) in zip(
        pairs, pairs[1:]
    ):
        short_gain = short_end - short_start
        long_gain = long_end - long_start
        if short_gain < COUPLED_MIN_INTERVAL_GAIN or long_gain < 0.0:
            continue
        if end_time - start_time > short_window_ms:
            continue
        if any(
            fraction < short_start - RESET_DROP
            for time, fraction in short_series
            if start_time < time < end_time
        ):
            continue
        total_short += short_gain
        total_long += long_gain
    if total_short < COUPLED_MIN_TOTAL_GAIN or total_long <= 0.0:
        return None, total_short
    ratio = total_long / total_short
    if ratio > COUPLED_MAX_RATIO + COUPLED_RATIO_EPSILON:
        return None, total_short
    return ratio, total_short


def window_duration_ms(window: dict) -> int | None:
    duration = window.get("durationMs")
    if isinstance(duration, int) and not isinstance(duration, bool) and duration > 0:
        return duration
    return None


def build_forecast(limit: dict, provider: str, snapshot: dict, now_ms: int) -> Forecast:
    limit_id = str(limit.get("id") or "")
    label = limit_label(limit)
    amount = limit.get("amount")
    amount = amount if isinstance(amount, dict) else {}
    used_percent = to_percent(amount.get("usedFraction"))
    used = used_percent / 100.0 if used_percent is not None else None
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    moment = reset_datetime(window.get("resetsAt"))
    resets_at_ms = int(moment.timestamp() * 1000) if moment is not None else None
    window_ms = window_duration_ms(window)
    lookback_ms = SHORT_LOOKBACK_MS if window_ms is not None and window_ms <= SHORT_WINDOW_MS else LONG_LOOKBACK_MS
    series = history_series(snapshot, provider, limit_id)
    rate = burn_rate(series, now_ms, used, lookback_ms) if used is not None else None
    hours_left = (resets_at_ms - now_ms) / 3_600_000 if (resets_at_ms is not None and resets_at_ms > now_ms) else None
    projected = min(1.0, used + rate * hours_left) if (rate is not None and hours_left is not None and used is not None) else None
    exhaust_in_ms = int((1.0 - used) / rate * 3_600_000) if (rate is not None and rate > 0 and used is not None and used < 1.0) else None
    status = limit.get("status")
    if used is None:
        verdict = "NO DATA"
    elif used >= 0.999 or status == "exhausted":
        verdict = "EXHAUSTED"
    elif rate is None or projected is None:
        verdict = "NO DATA"
    elif exhaust_in_ms is not None and hours_left is not None and exhaust_in_ms <= hours_left * 3_600_000:
        verdict = "RUN OUT"
    elif projected >= HOT_FRACTION:
        verdict = "HOT"
    elif projected >= SPARE_FRACTION:
        verdict = "ON PACE"
    else:
        verdict = "SPARE"
    spark = spark_buckets(series, now_ms, 48)
    return {
        "provider": provider,
        "limit_id": limit_id,
        "label": label,
        "used": used,
        "resets_at_ms": resets_at_ms,
        "window_ms": window_ms,
        "rate_per_hour": rate,
        "projected": projected,
        "exhaust_in_ms": exhaust_in_ms,
        "verdict": verdict,
        "coupled_limit_id": None,
        "coupled_window_ms": None,
        "coupled_ratio": None,
        "coupled_burn": None,
        "coupled_room": None,
        "spark": spark,
    }


def forecast_rows(provider: str, limits: list[dict], snapshot: dict, now_ms: int) -> list[Forecast]:
    return apply_window_coupling(
        [build_forecast(limit, provider, snapshot, now_ms) for limit in limits], snapshot
    )


def apply_window_coupling(forecasts: list[Forecast], snapshot: dict) -> list[Forecast]:
    """Price short-window usage into the co-moving long window it also burns."""
    shorts = [
        f
        for f in forecasts
        if f.get("window_ms") is not None
        and f["window_ms"] <= SHORT_WINDOW_MS
        and f.get("used") is not None
    ]
    longs = [
        f
        for f in forecasts
        if f.get("window_ms") is not None
        and f["window_ms"] >= COUPLED_LONG_WINDOW_MS
        and f.get("used") is not None
    ]
    if not shorts or not longs:
        return forecasts
    for f in shorts:
        short_series = history_series(snapshot, f["provider"], f["limit_id"])
        priced: list[tuple[float, float, str, float, float, float, Forecast]] = []
        for candidate in longs:
            ratio, support = coupled_gain_ratio(
                short_series,
                history_series(snapshot, candidate["provider"], candidate["limit_id"]),
                f["window_ms"],
            )
            if ratio is None:
                continue
            burn = ratio * (1.0 - f["used"])
            room = 1.0 - max(candidate["used"], candidate.get("projected") or 0.0)
            priced.append((room - burn, -support, candidate["limit_id"], ratio, burn, room, candidate))
        if not priced:
            continue
        _, _, _, ratio, burn, room, candidate = min(priced, key=lambda item: item[:3])
        f["coupled_limit_id"] = candidate["limit_id"]
        f["coupled_window_ms"] = candidate["window_ms"]
        f["coupled_ratio"] = ratio
        f["coupled_burn"] = burn
        f["coupled_room"] = room
        if f.get("verdict") in ("SPARE", "ON PACE") and burn >= room:
            f["verdict"] = "GATED"
    return forecasts


def fmt_window_short(window_ms) -> str:
    if not isinstance(window_ms, int) or isinstance(window_ms, bool) or window_ms <= 0:
        return "long"
    hours = round(window_ms / 3_600_000)
    if hours < 48:
        return f"{hours}h"
    return f"{round(hours / 24)}d"


def coupled_cost_suffix(f: Forecast) -> str:
    burn = f.get("coupled_burn")
    if burn is None:
        return ""
    return f" \u00b7 ~{burn * 100:.0f}% of {fmt_window_short(f.get('coupled_window_ms'))}"


def forecast_advice(f: Forecast, now_ms: int) -> str:
    verdict = f.get("verdict")
    if verdict == "EXHAUSTED":
        when = fmt_reset_estimate(f.get("resets_at_ms"))
        return f"exhausted \u00b7 wait, resets {when}" if when else "exhausted \u00b7 wait"
    if verdict == "RUN OUT":
        exhaust_in_ms = f.get("exhaust_in_ms") or 0
        resets_at_ms = f.get("resets_at_ms") or 0
        before_reset_ms = max(0, resets_at_ms - now_ms - exhaust_in_ms)
        return (
            f"tone it down \u00b7 hits 100% {fmt_duration(exhaust_in_ms)}, "
            f"{fmt_duration(before_reset_ms)} before reset"
        )
    if verdict == "HOT":
        projected = f.get("projected") or 0.0
        return f"ease off \u00b7 ~{projected * 100:.0f}% by reset"
    if verdict == "GATED":
        burn = f.get("coupled_burn") or 0.0
        room = f.get("coupled_room") or 0.0
        window = fmt_window_short(f.get("coupled_window_ms"))
        return f"{window} gates it \u00b7 full burn ~{burn * 100:.0f}%, room ~{room * 100:.0f}%"
    if verdict == "ON PACE":
        projected = f.get("projected") or 0.0
        return f"keep going \u00b7 ~{projected * 100:.0f}% by reset{coupled_cost_suffix(f)}"
    if verdict == "SPARE":
        projected = f.get("projected") or 0.0
        return f"crank it up \u00b7 ~{(1.0 - projected) * 100:.0f}% spare by reset{coupled_cost_suffix(f)}"
    if f.get("used") is None:
        return "no usage reported"
    return "not enough history yet"


def fmt_rate(f: Forecast | dict) -> str:
    rate = f.get("rate_per_hour")
    if rate is None:
        return "rate ?"
    window_ms = f.get("window_ms")
    if window_ms is not None and window_ms <= SHORT_WINDOW_MS:
        return f"+{rate * 100:.1f}%/h"
    return f"+{rate * 100 * 24:.1f}%/day"


def load_config() -> dict | None:
    try:
        raw = CLAUDE_CONFIG_PATH.read_text(encoding="utf-8")
    except OSError:
        return None
    config = {}
    for line in raw.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            config[key.strip()] = value.strip()
    token = config.get("TELEGRAM_BOT_TOKEN")
    chat_id = config.get("TELEGRAM_CHAT_ID")
    if isinstance(token, str) and token and isinstance(chat_id, str) and chat_id:
        return {"bot_token": token, "chat_id": chat_id}
    return None


def credentials(config: dict | None) -> tuple[str, object] | None:
    if not isinstance(config, dict):
        return None
    token = config.get("bot_token")
    chat_id = config.get("chat_id")
    if not isinstance(token, str) or not token or chat_id in (None, ""):
        return None
    return token, chat_id


def load_state() -> dict:
    try:
        raw = CODEX_STATE_PATH.read_text(encoding="utf-8")
    except FileNotFoundError:
        return {}
    except OSError as error:
        raise UsageError(f"codex usage state is unreadable: {error}", 2) from error
    try:
        state = json.loads(raw)
    except json.JSONDecodeError as error:
        raise UsageError(f"codex usage state is corrupt: {error}", 2) from error
    if not isinstance(state, dict):
        raise UsageError("codex usage state is corrupt: not a JSON object", 2)
    return state


def save_state(state: dict) -> None:
    CODEX_STATE_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(CODEX_STATE_PATH.parent, 0o700)
    descriptor, temporary = tempfile.mkstemp(
        dir=CODEX_STATE_PATH.parent, prefix=".state-", suffix=".tmp"
    )
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(state, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, CODEX_STATE_PATH)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def tg_call(bot_token: str, method: str, params: dict) -> dict:
    request = urllib.request.Request(
        f"{TELEGRAM_API_BASE}/bot{bot_token}/{method}",
        data=json.dumps(params).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TELEGRAM_TIMEOUT_SECONDS) as response:
        body = response.read()
    try:
        payload = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise TelegramError(f"Telegram {method} returned invalid JSON: {error}") from error
    if not isinstance(payload, dict) or payload.get("ok") is not True:
        description = payload.get("description", "unknown error") if isinstance(payload, dict) else "malformed response"
        raise TelegramError(f"Telegram {method} failed: {description}")
    return payload


def multipart_form(
    fields: dict[str, object],
    file_field: str,
    filename: str,
    media: bytes,
) -> tuple[bytes, str]:
    boundary = f"----omp-usage-{uuid4().hex}"
    parts = []
    for name, value in fields.items():
        text = str(value).lower() if isinstance(value, bool) else str(value)
        parts.extend(
            [
                f"--{boundary}\r\n".encode("ascii"),
                f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode("ascii"),
                text.encode("utf-8"),
                b"\r\n",
            ]
        )
    parts.extend(
        [
            f"--{boundary}\r\n".encode("ascii"),
            (
                f'Content-Disposition: form-data; name="{file_field}"; '
                f'filename="{filename}"\r\n'
            ).encode("ascii"),
            b"Content-Type: image/png\r\n\r\n",
            media,
            b"\r\n",
            f"--{boundary}--\r\n".encode("ascii"),
        ]
    )
    return b"".join(parts), boundary


def tg_upload(
    bot_token: str,
    method: str,
    fields: dict[str, object],
    file_field: str,
    filename: str,
    media: bytes,
) -> dict:
    body, boundary = multipart_form(fields, file_field, filename, media)
    request = urllib.request.Request(
        f"{TELEGRAM_API_BASE}/bot{bot_token}/{method}",
        data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TELEGRAM_TIMEOUT_SECONDS) as response:
        response_body = response.read()
    try:
        payload = json.loads(response_body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise TelegramError(f"Telegram {method} returned invalid JSON: {error}") from error
    if not isinstance(payload, dict) or payload.get("ok") is not True:
        description = (
            payload.get("description", "unknown error")
            if isinstance(payload, dict)
            else "malformed response"
        )
        raise TelegramError(f"Telegram {method} failed: {description}")
    return payload


def tg_send_photo(config: dict, image: bytes, caption: str, *, notify: bool = False) -> int:
    fields: dict[str, object] = {
        "chat_id": config["chat_id"],
        "caption": caption,
        "parse_mode": "HTML",
        "disable_notification": not notify,
    }
    payload = tg_upload(
        config["bot_token"],
        "sendPhoto",
        fields,
        "photo",
        "omp-usage.png",
        image,
    )
    result = payload.get("result")
    result = result if isinstance(result, dict) else {}
    message_id = valid_message_id(result.get("message_id"))
    if message_id is None:
        raise TelegramError("Telegram sendPhoto returned no message_id")
    return message_id


def tg_edit_photo(config: dict, message_id: int, image: bytes, caption: str) -> None:
    tg_upload(
        config["bot_token"],
        "editMessageMedia",
        {
            "chat_id": config["chat_id"],
            "message_id": message_id,
            "media": json.dumps(
                {
                    "type": "photo",
                    "media": "attach://photo",
                    "caption": caption,
                    "parse_mode": "HTML",
                },
                separators=(",", ":"),
            ),
        },
        "photo",
        "omp-usage.png",
        image,
    )


def tg_pin(config: dict, message_id: int) -> None:
    tg_call(
        config["bot_token"],
        "pinChatMessage",
        {
            "chat_id": config["chat_id"],
            "message_id": message_id,
            "disable_notification": True,
        },
    )


def edit_failure_action(description: str) -> str:
    lowered = description.casefold()
    if "message is not modified" in lowered:
        return "ok"
    if "message to edit not found" in lowered:
        return "replace"
    return "fail"


def deletion_failure_action(description: str) -> str:
    lowered = description.casefold()
    if "message to delete not found" in lowered or "message not found" in lowered:
        return "gone"
    if "can't be deleted" in lowered or "cannot be deleted" in lowered:
        return "pinned"
    return "retry"


def valid_message_id(value: object) -> int | None:
    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
        return None
    return value


def telegram_failure_description(error: urllib.error.HTTPError) -> str:
    try:
        return error.read().decode("utf-8", "replace")
    except (AttributeError, OSError, ValueError):
        return ""


def pin_dashboard(config: dict, state: dict, pinned_key: str, message_id: int) -> bool:
    try:
        tg_pin(config, message_id)
    except (urllib.error.HTTPError, OSError, TimeoutError, TelegramError) as error:
        print(f"codex-usage-check: failed to pin the dashboard message: {error}", file=sys.stderr)
        return False
    state[pinned_key] = message_id
    try:
        save_state(state)
    except OSError as error:
        print(f"codex-usage-check: failed to save pinned message id: {error}", file=sys.stderr)
        return False
    return True


def clear_retired_key(state: dict, state_key: str) -> None:
    state.pop(state_key, None)
    try:
        save_state(state)
    except OSError as error:
        print(f"codex-usage-check: failed to save retired state: {error}", file=sys.stderr)


def unpin_retired_message(config: dict, state: dict, state_key: str, message_id: int) -> None:
    try:
        tg_call(
            config["bot_token"],
            "unpinChatMessage",
            {"chat_id": config["chat_id"], "message_id": message_id},
        )
    except (urllib.error.HTTPError, OSError, TimeoutError, TelegramError) as error:
        print(f"codex-usage-check: failed to unpin superseded {state_key} message {message_id}: {error}", file=sys.stderr)
        return
    clear_retired_key(state, state_key)


def retire_message(config: dict, state: dict, state_key: str, message_id: int) -> None:
    try:
        tg_call(
            config["bot_token"],
            "deleteMessage",
            {"chat_id": config["chat_id"], "message_id": message_id},
        )
    except urllib.error.HTTPError as error:
        description = telegram_failure_description(error)
        action = deletion_failure_action(description)
        if action == "gone":
            clear_retired_key(state, state_key)
        elif action == "pinned":
            unpin_retired_message(config, state, state_key, message_id)
        else:
            print(f"codex-usage-check: failed to delete superseded {state_key} message {message_id}: {description}", file=sys.stderr)
    except TelegramError as error:
        action = deletion_failure_action(str(error))
        if action == "gone":
            clear_retired_key(state, state_key)
        elif action == "pinned":
            unpin_retired_message(config, state, state_key, message_id)
        else:
            print(f"codex-usage-check: failed to delete superseded {state_key} message {message_id}: {error}", file=sys.stderr)
    except (OSError, TimeoutError) as error:
        print(f"codex-usage-check: failed to delete superseded {state_key} message {message_id}: {error}", file=sys.stderr)
    else:
        clear_retired_key(state, state_key)


def retire_superseded_messages(config: dict, state: dict) -> None:
    live_ids = {
        valid_message_id(state.get(key))
        for key in (LIMITS_STATE_KEY, PINNED_STATE_KEY, FORECAST_STATE_KEY, FORECAST_PINNED_STATE_KEY)
    }
    for state_key in RETIRED_STATE_KEYS:
        stale_id = valid_message_id(state.get(state_key))
        if stale_id is None or stale_id in live_ids:
            continue
        retire_message(config, state, state_key, stale_id)


def update_pinned(
    config: dict,
    image: bytes,
    caption: str,
    *,
    message_key: str,
    pinned_key: str,
    force_pin: bool = False,
) -> bool:
    state = load_state()
    message_id = valid_message_id(state.get(message_key))
    if message_id is not None:
        action = ""
        try:
            tg_edit_photo(config, message_id, image, caption)
            action = "ok"
        except urllib.error.HTTPError as error:
            action = edit_failure_action(telegram_failure_description(error)) if error.code == 400 else "fail"
        except (TelegramError, OSError, TimeoutError):
            action = "fail"
        if action == "ok":
            needs_pin = force_pin or valid_message_id(state.get(pinned_key)) != message_id
            if needs_pin and not pin_dashboard(config, state, pinned_key, message_id):
                return False
            retire_superseded_messages(config, state)
            return True
        if action != "replace":
            return False
    try:
        new_message_id = tg_send_photo(config, image, caption)
    except (OSError, TimeoutError, TelegramError) as error:
        print(f"codex-usage-check: failed to send the dashboard image: {error}", file=sys.stderr)
        return False
    state[message_key] = new_message_id
    try:
        save_state(state)
    except OSError as error:
        print(f"codex-usage-check: failed to save dashboard message id: {error}", file=sys.stderr)
        return False
    if not pin_dashboard(config, state, pinned_key, new_message_id):
        return False
    retire_superseded_messages(config, state)
    return True


class WindowReset(TypedDict):
    provider: str
    kind: str
    label: str
    amount_text: str
    closed_used: float
    closed_at_ms: int
    resets_at_ms: int
    fresh_used: float


def long_window_kind(limit: dict) -> str | None:
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    duration = window_duration_ms(window)
    if duration is not None:
        if duration < WEEKLY_WINDOW_MS:
            return None
        return "monthly" if duration >= MONTHLY_WINDOW_MS else "weekly"
    text = " ".join(
        part.casefold()
        for part in (window.get("id"), window.get("label"), limit.get("label"))
        if isinstance(part, str)
    )
    if "month" in text or "1mo" in text or "30d" in text:
        return "monthly"
    if "week" in text or "7 day" in text or "7d" in text:
        return "weekly"
    return None


def _amount_number(value: object) -> float | None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    number = float(value)
    return number if math.isfinite(number) and number >= 0 else None


def _format_amount(number: float) -> str:
    return f"{int(number):,}" if number.is_integer() else f"{number:,.1f}"


def window_amount_text(amount: dict) -> str:
    unit = amount.get("unit")
    used = _amount_number(amount.get("used"))
    limit = _amount_number(amount.get("limit"))
    if unit in ("percent", None) or used is None or limit is None:
        return ""
    return f"{_format_amount(used)}/{_format_amount(limit)} {unit}"


def tracked_window_limits(payload: dict, now_ms: int) -> dict[str, dict]:
    tracked: dict[str, dict] = {}
    grouped: dict[str, list[dict]] = {}
    for report in usable_reports(payload):
        grouped.setdefault(report["provider"], []).append(report)
    for provider, reports in grouped.items():
        id_counts: dict[str, int] = {}
        for report in reports:
            limits = report.get("limits")
            if not isinstance(limits, list):
                continue
            for limit in limits:
                if isinstance(limit, dict):
                    limit_id = str(limit.get("id") or "limit")
                    id_counts[limit_id] = id_counts.get(limit_id, 0) + 1
        for report_index, report in enumerate(reports):
            limits = report.get("limits")
            if not isinstance(limits, list):
                continue
            for limit in limits:
                if not isinstance(limit, dict):
                    continue
                kind = long_window_kind(limit)
                if kind is None:
                    continue
                window = limit.get("window")
                window = window if isinstance(window, dict) else {}
                moment = reset_datetime(window.get("resetsAt"))
                amount = limit.get("amount")
                amount = amount if isinstance(amount, dict) else {}
                used_percent = to_percent(amount.get("usedFraction"))
                if moment is None or used_percent is None:
                    continue
                limit_id = str(limit.get("id") or "limit")
                if id_counts.get(limit_id, 0) > 1:
                    continue
                label = limit.get("label") or window.get("label")
                tracked[f"{provider}:{report_index}:{limit_id}"] = {
                    "provider": provider,
                    "kind": kind,
                    "label": label.strip() if isinstance(label, str) and label.strip() else "long window",
                    "amount_text": window_amount_text(amount),
                    "resets_at_ms": int(moment.timestamp() * 1000),
                    "used": used_percent / 100.0,
                    "seen_at_ms": now_ms,
                }
    return tracked


def detect_window_resets(previous: dict, current: dict) -> list[WindowReset]:
    resets: list[WindowReset] = []
    for key, entry in current.items():
        old = previous.get(key)
        if not isinstance(old, dict):
            continue
        old_resets = old.get("resets_at_ms")
        old_used = old.get("used")
        if isinstance(old_resets, bool) or not isinstance(old_resets, int):
            continue
        if isinstance(old_used, bool) or not isinstance(old_used, (int, float)):
            continue
        if entry["resets_at_ms"] <= old_resets + RESET_FORWARD_TOLERANCE_MS:
            continue
        closed_used = float(old_used)
        if closed_used < RESET_ANNOUNCE_MIN_USED:
            continue
        if closed_used - entry["used"] < RESET_DROP:
            continue
        kind = old.get("kind")
        label = old.get("label")
        resets.append({
            "provider": entry["provider"],
            "kind": kind if isinstance(kind, str) and kind else entry["kind"],
            "label": label if isinstance(label, str) and label.strip() else entry["label"],
            "amount_text": old.get("amount_text") if isinstance(old.get("amount_text"), str) else "",
            "closed_used": closed_used,
            "closed_at_ms": old_resets,
            "resets_at_ms": entry["resets_at_ms"],
            "fresh_used": entry["used"],
        })
    resets.sort(key=lambda item: (item["provider"], item["label"]))
    return resets


def merged_watch(previous: dict, current: dict, now_ms: int) -> dict:
    merged: dict[str, dict] = {}
    for key, entry in previous.items():
        if not isinstance(entry, dict):
            continue
        seen_at = entry.get("seen_at_ms")
        if isinstance(seen_at, int) and not isinstance(seen_at, bool) and now_ms - seen_at >= RESET_WATCH_TTL_MS:
            continue
        merged[key] = entry
    merged.update(current)
    return merged


def persist_watch(merged: dict) -> bool:
    state = load_state()
    if state.get(RESET_WATCH_STATE_KEY) == merged:
        return True
    if not merged and RESET_WATCH_STATE_KEY not in state:
        return True
    state[RESET_WATCH_STATE_KEY] = merged
    try:
        save_state(state)
    except OSError as error:
        print(f"codex-usage-check: failed to persist reset watch: {error}", file=sys.stderr)
        return False
    return True


def reset_message(resets: list[WindowReset]) -> str:
    kinds = {reset["kind"] for reset in resets}
    if kinds == {"weekly"}:
        title = "Weekly limit reset"
    elif kinds == {"monthly"}:
        title = "Monthly limit reset"
    else:
        title = "Limit resets"
    lines = [f"<b>{title}</b>"]
    grouped: dict[str, list[WindowReset]] = {}
    for reset in resets:
        grouped.setdefault(reset["provider"], []).append(reset)
    shown = 0
    overflow = 0
    for provider in sorted(grouped):
        if overflow:
            break
        block = [f"<b>{provider_display(provider)}</b>"]
        for reset in grouped[provider]:
            usage = f" ({escape(reset['amount_text'])})" if reset["amount_text"] else ""
            detail = (
                f"{escape(reset['label'])} · closed at <b>{reset['closed_used'] * 100:.1f}%</b> used{usage} · "
                f"fresh window resets <b>{escape(fmt_reset(reset['resets_at_ms']))}</b>"
            )
            if len("\n".join([*lines, *block, detail])) > CAPTION_MAX_CHARS - CAPTION_OVERFLOW_RESERVE:
                overflow = len(resets) - shown
                break
            block.append(detail)
            shown += 1
        if len(block) > 1:
            lines.extend(["", *block])
    if overflow:
        lines.append(f"+{overflow} more")
    return "\n".join(lines)


def reset_events(resets: list[WindowReset]) -> list[dashboard.ResetEvent]:
    return [
        dashboard.ResetEvent(
            provider=reset["provider"],
            label=reset["label"],
            kind=reset["kind"],
            closed_used_percent=reset["closed_used"] * 100.0,
            closed_at_ms=reset["closed_at_ms"],
            fresh_used_percent=reset["fresh_used"] * 100.0,
            resets_at_ms=reset["resets_at_ms"],
            amount_text=reset["amount_text"],
        )
        for reset in resets
    ]


def announce_window_resets(config: dict, payload: dict) -> int:
    now_ms = time.time_ns() // 1_000_000
    current = tracked_window_limits(payload, now_ms)
    watch = load_state().get(RESET_WATCH_STATE_KEY)
    watch = watch if isinstance(watch, dict) else {}
    resets = detect_window_resets(watch, current)
    merged = merged_watch(watch, current, now_ms)
    if resets:
        try:
            image = render_reset(reset_events(resets), now_ms)
        except UsageError as error:
            return fail(error)
        try:
            tg_send_photo(config, image, reset_message(resets), notify=True)
        except (urllib.error.HTTPError, OSError, TimeoutError, TelegramError) as error:
            print(f"codex-usage-check: failed to send limit reset message: {error}", file=sys.stderr)
            return 2
    if not persist_watch(merged):
        return 2
    return 0


def valid_ssh_host(value: object) -> str | None:
    if not isinstance(value, str) or not value:
        return None
    if value.startswith("-") or any(char.isspace() for char in value):
        return None
    return value


def check_ssh_host() -> str | None:
    return valid_ssh_host(os.environ.get(TOKEN_SSH_HOST_ENV))


def collector_source(path: Path) -> bytes:
    try:
        return path.read_bytes()
    except OSError as error:
        raise UsageError(f"collector unreadable: {path.name}: {error}", 1) from error


def local_source_label() -> str:
    override = os.environ.get(SOURCE_LABEL_ENV)
    if override is not None:
        label = override.strip()
        if not SOURCE_LABEL_PATTERN.fullmatch(label):
            raise UsageError(f"invalid {SOURCE_LABEL_ENV}: {override!r}", 1)
        return label
    label = socket.gethostname().split(".", 1)[0]
    if not SOURCE_LABEL_PATTERN.fullmatch(label):
        raise UsageError(f"hostname {label!r} is not a valid source label; set {SOURCE_LABEL_ENV}", 1)
    return label


def local_token_collection(start_ms: int, end_ms: int) -> tuple[str, dict | None, list[str]]:
    label = local_source_label()
    try:
        collection = token_usage.collect_usage(Path.home() / ".omp", start_ms, end_ms)
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        return label, None, [f"{label} unavailable: collector failure"]
    if not isinstance(collection, dict):
        return label, None, [f"{label} unavailable: invalid collection"]
    return label, collection, []


def local_history_collection(start_ms: int, end_ms: int) -> tuple[str, dict | None, list[str]]:
    label = local_source_label()
    try:
        collection = usage_history.collect_history(Path.home() / ".omp", start_ms, end_ms)
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        return label, None, [f"{label} unavailable: collector failure"]
    if not isinstance(collection, dict):
        return label, None, [f"{label} unavailable: invalid collection"]
    return label, collection, []


def local_activity_collection(start_ms: int, end_ms: int) -> tuple[str, dict | None, list[str]]:
    label = local_source_label()
    try:
        collection = activity_usage.collect_activity(Path.home() / ".omp", start_ms, end_ms)
    except (OSError, ValueError, TypeError, KeyError, AttributeError, RecursionError):
        return label, None, [f"{label} unavailable: collector failure"]
    if not isinstance(collection, dict):
        return label, None, [f"{label} unavailable: invalid collection"]
    return label, collection, []


def remote_label(host: str) -> str:
    return host.rsplit("@", 1)[-1].split(".", 1)[0]


def remote_collection(host: str, source: bytes, start_ms: int, end_ms: int) -> tuple[str, dict | None, list[str]]:
    label = remote_label(host)
    command = [
        TOKEN_SSH_BINARY,
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "ConnectTimeout=10",
        "-o",
        "ServerAliveInterval=10",
        "-o",
        "ServerAliveCountMax=2",
        host,
        TOKEN_SSH_PYTHON,
        "-",
        "--start-ms",
        str(start_ms),
        "--end-ms",
        str(end_ms),
    ]
    try:
        completed = subprocess.run(
            command,
            input=source,
            capture_output=True,
            timeout=TOKEN_SSH_TIMEOUT_SECONDS,
            check=False,
        )
    except FileNotFoundError:
        return label, None, [f"{label} unavailable: ssh binary not found"]
    except subprocess.TimeoutExpired:
        return label, None, [f"{label} unavailable: ssh timed out"]
    except OSError as error:
        return label, None, [f"{label} unavailable: {error}"]
    stdout = completed.stdout or b""
    if completed.returncode == 255:
        print("codex-usage-check: token ssh connection failed", file=sys.stderr)
        return label, None, [f"{label} unavailable: ssh connection failed"]
    if completed.returncode not in (0, 2):
        print(f"codex-usage-check: token ssh exited {completed.returncode}", file=sys.stderr)
        return label, None, [f"{label} unavailable: remote collector exited {completed.returncode}"]
    try:
        collection = json.loads(stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        print("codex-usage-check: token ssh returned invalid JSON", file=sys.stderr)
        return label, None, [f"{label} unavailable: invalid remote collection"]
    if not isinstance(collection, dict):
        print("codex-usage-check: token ssh returned invalid collection", file=sys.stderr)
        return label, None, [f"{label} unavailable: invalid remote collection"]
    if completed.returncode == 2 and not collection.get("issues"):
        print("codex-usage-check: token ssh returned inconsistent collection", file=sys.stderr)
        return label, None, [f"{label} unavailable: invalid remote collection"]
    return label, collection, []


def gather_collections(
    source_path: Path,
    local: Callable[[int, int], tuple[str, dict | None, list[str]]],
    start_ms: int,
    end_ms: int,
) -> tuple[list[tuple[str, dict]], list[str]]:
    collections: list[tuple[str, dict]] = []
    snapshot_issues: list[str] = []
    label, local_collection, local_issues = local(start_ms, end_ms)
    snapshot_issues.extend(local_issues)
    if local_collection is not None:
        collections.append((label, local_collection))
    host = check_ssh_host()
    if host is not None:
        try:
            source = collector_source(source_path)
        except UsageError as error:
            print(f"codex-usage-check: {error}", file=sys.stderr)
            snapshot_issues.append(f"{remote_label(host)} unavailable: collector unreadable")
            source = None
        if source is not None:
            label, remote_collection_result, remote_issues = remote_collection(host, source, start_ms, end_ms)
            snapshot_issues.extend(remote_issues)
            if remote_collection_result is not None:
                collections.append((label, remote_collection_result))
    return collections, snapshot_issues


def token_window(now_ms: int) -> tuple[int, int]:
    start_ms = (now_ms // TOKEN_DAY_MS - TOKEN_LOOKBACK_DAYS + 1) * TOKEN_DAY_MS
    return start_ms, now_ms


def history_window(now_ms: int) -> tuple[int, int]:
    return now_ms - HISTORY_LOOKBACK_DAYS * TOKEN_DAY_MS, now_ms


def activity_window(now_ms: int) -> tuple[int, int]:
    return now_ms - ACTIVITY_LOOKBACK_DAYS * TOKEN_DAY_MS, now_ms


def relay_directory() -> Path:
    return Path(os.environ.get(RELAY_DIR_ENV) or RELAY_DIR)


def expected_relay_sources() -> list[str]:
    names = [part.strip() for part in os.environ.get(RELAY_SOURCES_ENV, "").split(",") if part.strip()]
    invalid = [name for name in names if not SOURCE_LABEL_PATTERN.fullmatch(name)]
    if invalid:
        raise UsageError(f"invalid {RELAY_SOURCES_ENV} entry: {invalid[0]!r}", 1)
    return names


def relay_age_text(age_ms: int) -> str:
    minutes = abs(age_ms) // 60_000
    if minutes < 120:
        return f"{minutes}m"
    if minutes < 48 * 60:
        return f"{minutes // 60}h"
    return f"{minutes // 1440}d"


def is_plain_int(value: object) -> bool:
    return isinstance(value, int) and not isinstance(value, bool)


def valid_relay_section(section: object) -> bool:
    if not isinstance(section, dict):
        return False
    if not is_plain_int(section.get("start_ms")) or not is_plain_int(section.get("end_ms")):
        return False
    collections = section.get("collections")
    issues = section.get("issues")
    if not isinstance(collections, list) or not isinstance(issues, list):
        return False
    if not all(isinstance(issue, str) for issue in issues):
        return False
    return all(
        isinstance(entry, dict) and isinstance(entry.get("source"), str) and isinstance(entry.get("collection"), dict)
        for entry in collections
    )


def read_relay_bundle(path: Path, kind: str, required: bool = True) -> dict | None:
    try:
        with gzip.open(path, "rb") as handle:
            raw = handle.read(RELAY_MAX_BYTES + 1)
    except (OSError, EOFError, zlib.error):
        return None
    if len(raw) > RELAY_MAX_BYTES:
        return None
    try:
        bundle = json.loads(raw)
    except (ValueError, RecursionError):
        return None
    if not isinstance(bundle, dict):
        return None
    if bundle.get("schema") != RELAY_SCHEMA or not is_plain_int(bundle.get("generated_at_ms")):
        return None
    if not isinstance(bundle.get("source"), str):
        return None
    section = bundle.get(kind)
    if section is None:
        return None if required else bundle
    if not valid_relay_section(section):
        return None
    return bundle


def relay_entry_outside_window(entry: object, time_key: str, start_ms: int, end_ms: int) -> bool:
    if not isinstance(entry, dict):
        return False
    timestamp = entry.get(time_key)
    return is_plain_int(timestamp) and not start_ms <= timestamp < end_ms


def rewindow_collection(collection: dict, kind: str, start_ms: int, end_ms: int) -> dict:
    list_key, time_key = RELAY_ENTRY_FIELDS[kind]
    entries = collection.get(list_key)
    rewound = {**collection, "start_ms": start_ms, "end_ms": end_ms}
    if isinstance(entries, list):
        rewound[list_key] = [entry for entry in entries if not relay_entry_outside_window(entry, time_key, start_ms, end_ms)]
    return rewound


def relay_collections(
    kind: str,
    start_ms: int,
    end_ms: int,
    now_ms: int,
    required: bool = True,
) -> tuple[list[tuple[str, dict]], list[str]]:
    expected = expected_relay_sources()
    directory = relay_directory()
    paths = sorted(directory.glob(f"*{RELAY_SUFFIX}")) if directory.is_dir() else []
    collections: list[tuple[str, dict]] = []
    issues: list[str] = []
    present: set[str] = set()
    for path in paths:
        name = path.name.removesuffix(RELAY_SUFFIX)
        present.add(name)
        bundle = read_relay_bundle(path, kind, required)
        if bundle is None:
            issues.append(f"{name} relay unreadable")
            continue
        section = bundle.get(kind)
        if section is None:
            continue
        age_ms = now_ms - bundle["generated_at_ms"]
        if age_ms > RELAY_STALE_MS:
            issues.append(f"{bundle['source']} relay {relay_age_text(age_ms)} old")
        elif age_ms < -RELAY_STALE_MS:
            issues.append(f"{bundle['source']} relay clock {relay_age_text(age_ms)} ahead")
        issues.extend(section["issues"])
        for entry in section["collections"]:
            collections.append((entry["source"], rewindow_collection(entry["collection"], kind, start_ms, end_ms)))
    issues.extend(f"{name} relay missing" for name in expected if name not in present)
    return collections, issues


def collect_token_snapshot(now_ms: int) -> token_usage.TokenSnapshot:
    require_token_usage()
    start_ms, end_ms = token_window(now_ms)
    collections, issues = gather_collections(TOKEN_USAGE_PATH, local_token_collection, start_ms, end_ms)
    relayed, relay_issues = relay_collections("tokens", start_ms, end_ms, now_ms)
    snapshot = token_usage.merge_usage([*collections, *relayed], start_ms, end_ms)
    issues = [*issues, *relay_issues]
    if issues:
        snapshot["issues"] = [*issues, *snapshot.get("issues", [])]
    return snapshot


def collect_history_snapshot(now_ms: int) -> usage_history.HistorySnapshot:
    require_usage_history()
    start_ms, end_ms = history_window(now_ms)
    collections, issues = gather_collections(USAGE_HISTORY_PATH, local_history_collection, start_ms, end_ms)
    relayed, relay_issues = relay_collections("history", start_ms, end_ms, now_ms)
    snapshot = usage_history.merge_history([*collections, *relayed], start_ms, end_ms)
    issues = [*issues, *relay_issues]
    if issues:
        snapshot["issues"] = [*issues, *snapshot.get("issues", [])]
    return snapshot


def collect_activity_snapshot(now_ms: int) -> tuple[list[dict], list[str]]:
    require_activity_usage()
    start_ms, end_ms = activity_window(now_ms)
    collections, issues = gather_collections(ACTIVITY_USAGE_PATH, local_activity_collection, start_ms, end_ms)
    relayed, relay_issues = relay_collections("activity", start_ms, end_ms, now_ms, required=False)
    merge_issues: list[str] = []
    records = activity_usage.merge_activity([*collections, *relayed], start_ms, end_ms, merge_issues)
    return records, [*issues, *relay_issues, *merge_issues]


def bundle_section(start_ms: int, end_ms: int, collections: list[tuple[str, dict]], issues: list[str]) -> dict:
    return {
        "start_ms": start_ms,
        "end_ms": end_ms,
        "collections": [{"source": label, "collection": collection} for label, collection in collections],
        "issues": issues,
    }


def build_relay_bundle(now_ms: int) -> dict:
    require_token_usage()
    require_usage_history()
    require_activity_usage()
    token_start, token_end = token_window(now_ms)
    history_start, history_end = history_window(now_ms)
    activity_start, activity_end = activity_window(now_ms)
    token_collections, token_issues = gather_collections(
        TOKEN_USAGE_PATH, local_token_collection, token_start, token_end
    )
    history_collections, history_issues = gather_collections(
        USAGE_HISTORY_PATH, local_history_collection, history_start, history_end
    )
    activity_collections, activity_issues = gather_collections(
        ACTIVITY_USAGE_PATH, local_activity_collection, activity_start, activity_end
    )
    return {
        "schema": RELAY_SCHEMA,
        "source": local_source_label(),
        "generated_at_ms": now_ms,
        "tokens": bundle_section(token_start, token_end, token_collections, token_issues),
        "history": bundle_section(history_start, history_end, history_collections, history_issues),
        "activity": bundle_section(activity_start, activity_end, activity_collections, activity_issues),
    }


def payload_updated_ms(payload: dict | None, checked_ms: int) -> int | None:
    if payload is None:
        return None
    moment = reset_datetime(payload.get("generatedAt"))
    return int(moment.timestamp() * 1000) if moment is not None else checked_ms


def dashboard_caption(view: dashboard.Dashboard) -> str:
    checked = datetime.fromtimestamp(view.now_ms / 1000, timezone.utc)
    caption = f"OMP usage · checked {checked:%Y-%m-%d %H:%M UTC}"
    if not view.quotas:
        caption += f" · {view.quota_issue or 'provider quotas unavailable'}"
    return caption


def forecast_caption(checked_ms: int) -> str:
    checked = datetime.fromtimestamp(checked_ms / 1000, timezone.utc)
    return f"OMP predictions · checked {checked:%Y-%m-%d %H:%M UTC}"


def build_dashboard(
    payload: dict | None,
    tokens: token_usage.TokenSnapshot | None,
    history: usage_history.HistorySnapshot | None,
    now_ms: int,
    activity: list[dict] | None = None,
) -> dashboard.Dashboard:
    require_dashboard()
    quotas: list[dashboard.ProviderQuota] = []
    quota_issue: str | None = None
    if payload is None:
        quota_issue = "OMP usage unavailable"
    else:
        reports = usable_reports(payload)
        if not reports:
            quota_issue = "No provider reports"
        for report in reports:
            metadata = report.get("metadata")
            metadata = metadata if isinstance(metadata, dict) else {}
            provider = report["provider"]
            raw_limits = report.get("limits")
            limits = (
                [limit for limit in raw_limits if isinstance(limit, dict)]
                if isinstance(raw_limits, list)
                else []
            )
            limits.sort(key=limit_reset_key)
            forecasts = (
                forecast_rows(provider, limits, history if history is not None else {}, now_ms)
                if provider in FORECAST_PROVIDERS
                else None
            )
            windows = []
            for index, limit in enumerate(limits):
                forecast = forecasts[index] if forecasts is not None else None
                window = limit.get("window")
                window = window if isinstance(window, dict) else {}
                amount = limit.get("amount")
                amount = amount if isinstance(amount, dict) else {}
                moment = reset_datetime(window.get("resetsAt"))
                status = limit.get("status")
                pace = None
                if forecast is not None:
                    projected = forecast.get("projected")
                    pace = dashboard.Pace(
                        verdict=forecast["verdict"],
                        projected_percent=projected * 100.0 if projected is not None else None,
                        rate=fmt_rate(forecast),
                        detail=forecast_advice(forecast, now_ms),
                        exhaust_in_ms=forecast["exhaust_in_ms"],
                        spark=tuple(forecast["spark"]),
                    )
                windows.append(
                    dashboard.QuotaWindow(
                        label=limit_label(limit),
                        used_percent=to_percent(amount.get("usedFraction")),
                        reset_ms=int(moment.timestamp() * 1000) if moment is not None else None,
                        status=status if isinstance(status, str) and status else None,
                        pace=pace,
                        window_ms=window_duration_ms(window),
                    )
                )
            quotas.append(
                dashboard.ProviderQuota(provider=provider, account="", plan=plan_metadata(metadata.get("planType")), windows=windows)
            )
    return dashboard.Dashboard(
        now_ms=now_ms,
        quota_updated_ms=payload_updated_ms(payload, now_ms),
        quotas=quotas,
        quota_issue=quota_issue,
        tokens=tokens,
        history_sources=list(history["sources_ok"]) if history else [],
        history_partial=history is None or bool(history.get("issues")),
        recent=tuple(activity or []),
    )


def render_png(svg: bytes) -> bytes:
    ffmpeg = os.environ.get("FFMPEG_BIN", "ffmpeg")
    command = [
        ffmpeg,
        "-hide_banner",
        "-loglevel",
        "error",
        "-f",
        "svg_pipe",
        "-frame_size",
        str(len(svg)),
        "-i",
        "pipe:0",
        "-frames:v",
        "1",
        "-c:v",
        "png",
        "-pix_fmt",
        "rgb24",
        "-threads",
        "1",
        "-f",
        "image2pipe",
        "pipe:1",
    ]
    try:
        completed = subprocess.run(
            command,
            input=svg,
            capture_output=True,
            timeout=FFMPEG_TIMEOUT_SECONDS,
            check=False,
            env={**os.environ, "FONTCONFIG_FILE": str(FONTCONFIG_PATH)},
        )
    except FileNotFoundError:
        raise UsageError(f"ffmpeg binary not found: {ffmpeg}", 1) from None
    except subprocess.TimeoutExpired:
        raise UsageError(f"image render timed out after {FFMPEG_TIMEOUT_SECONDS}s", 2) from None
    except OSError as error:
        raise UsageError(f"failed to render image: {error}", 2) from error
    if completed.returncode != 0 or not completed.stdout:
        raise UsageError(f"ffmpeg failed to render image (exit {completed.returncode})", 2)
    return completed.stdout


def render_dashboard(view: dashboard.Dashboard) -> bytes:
    require_dashboard()
    try:
        svg = dashboard.render_svg(view)
    except OSError as error:
        raise UsageError(f"failed to load dashboard assets: {error}", 1) from error
    return render_png(svg)


def render_forecast(view: dashboard.Dashboard) -> bytes:
    require_dashboard()
    try:
        svg = dashboard.render_forecast_svg(view)
    except OSError as error:
        raise UsageError(f"failed to load dashboard assets: {error}", 1) from error
    return render_png(svg)


def render_reset(events: list[dashboard.ResetEvent], now_ms: int) -> bytes:
    require_dashboard()
    try:
        svg = dashboard.render_reset_svg(events, now_ms)
    except OSError as error:
        raise UsageError(f"failed to load dashboard assets: {error}", 1) from error
    return render_png(svg)


def write_widget_file(directory: Path, name: str, data: bytes) -> None:
    descriptor, temporary = tempfile.mkstemp(dir=directory, prefix=f".{name}-", suffix=".tmp")
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
        os.chmod(temporary, 0o600)
        os.replace(temporary, directory / name)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def export_widget(view: dashboard.Dashboard) -> int:
    directory = Path(os.environ.get(WIDGET_DIR_ENV) or WIDGET_DIR)
    try:
        detail = DETAIL_PATH.read_bytes()
    except OSError as error:
        print(f"codex-usage-check: failed to read {DETAIL_NAME}: {error}", file=sys.stderr)
        return 2
    manifest = {
        "schema": WIDGET_SCHEMA,
        "generated_at_ms": view.now_ms,
        "lock": dashboard.widget_summary(view),
        "windows": dashboard.windows_summary(view),
        "recent": dashboard.recent_summary(view),
        "usage": dashboard.usage_summary(view),
    }
    try:
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(directory, 0o700)
        write_widget_file(directory, DETAIL_NAME, detail)
        write_widget_file(directory, "widget.json", json.dumps(manifest, separators=(",", ":")).encode("utf-8"))
        for name in RETIRED_WIDGET_IMAGES:
            (directory / name).unlink(missing_ok=True)
    except OSError as error:
        print(f"codex-usage-check: failed to write widget files: {error}", file=sys.stderr)
        return 2
    return 0


def omp_payload_section() -> tuple[dict | None, int]:
    try:
        return run_omp_usage(), 0
    except UsageError as error:
        print(f"codex-usage-check: {error}", file=sys.stderr)
        return None, error.exit_code


def token_snapshot_section(start_ms: int) -> tuple[token_usage.TokenSnapshot | None, int]:
    try:
        snapshot = collect_token_snapshot(start_ms)
    except UsageError as error:
        print(f"codex-usage-check: {error}", file=sys.stderr)
        return None, error.exit_code
    except (OSError, ValueError, TypeError, KeyError, AttributeError) as error:
        print(f"codex-usage-check: token collection failed: {error}", file=sys.stderr)
        return None, 2
    return snapshot, 2 if snapshot.get("issues") else 0


def history_snapshot_section(start_ms: int) -> tuple[usage_history.HistorySnapshot | None, int]:
    try:
        snapshot = collect_history_snapshot(start_ms)
    except UsageError as error:
        print(f"codex-usage-check: {error}", file=sys.stderr)
        return None, error.exit_code
    except (OSError, ValueError, TypeError, KeyError, AttributeError) as error:
        print(f"codex-usage-check: history collection failed: {error}", file=sys.stderr)
        return None, 2
    return snapshot, 2 if snapshot.get("issues") else 0


def activity_snapshot_section(start_ms: int) -> tuple[list[dict] | None, int]:
    try:
        records, issues = collect_activity_snapshot(start_ms)
    except UsageError as error:
        print(f"codex-usage-check: {error}", file=sys.stderr)
        return None, error.exit_code
    except (OSError, ValueError, TypeError, KeyError, AttributeError, RecursionError) as error:
        print(f"codex-usage-check: activity collection failed: {error}", file=sys.stderr)
        return None, 2
    for issue in issues:
        print(f"codex-usage-check: activity: {issue}", file=sys.stderr)
    return records, 2 if issues else 0


def section_exit_code(codes: list[int]) -> int:
    if 1 in codes:
        return 1
    if 2 in codes:
        return 2
    return 0


def publish_predictions(config: dict, view: dashboard.Dashboard, *, force_pin: bool) -> int:
    try:
        image = render_forecast(view)
        updated = update_pinned(
            config,
            image,
            forecast_caption(view.now_ms),
            message_key=FORECAST_STATE_KEY,
            pinned_key=FORECAST_PINNED_STATE_KEY,
            force_pin=force_pin,
        )
    except UsageError as error:
        return fail(error)
    if not updated:
        print("codex-usage-check: failed to update the predictions message", file=sys.stderr)
        return 2
    return 0


def publish_dashboard(config: dict, *, force_pin: bool = False) -> int:
    started_ms = time.time_ns() // 1_000_000
    with ThreadPoolExecutor(max_workers=4) as pool:
        payload_task = pool.submit(omp_payload_section)
        tokens_task = pool.submit(token_snapshot_section, started_ms)
        history_task = pool.submit(history_snapshot_section, started_ms)
        activity_task = pool.submit(activity_snapshot_section, started_ms)
        payload, payload_code = payload_task.result()
        tokens, tokens_code = tokens_task.result()
        history, history_code = history_task.result()
        activity, activity_code = activity_task.result()
    codes = [payload_code, tokens_code, history_code, activity_code]
    quotas_usable = payload is not None
    tokens_usable = tokens is not None and bool(tokens.get("sources_ok"))
    if not quotas_usable and not tokens_usable:
        return section_exit_code(codes)
    checked_ms = time.time_ns() // 1_000_000
    try:
        view = build_dashboard(payload, tokens, history, checked_ms, activity)
    except UsageError as error:
        return fail(error)
    widget_code = export_widget(view)
    try:
        image = render_dashboard(view)
        updated = update_pinned(
            config,
            image,
            dashboard_caption(view),
            message_key=LIMITS_STATE_KEY,
            pinned_key=PINNED_STATE_KEY,
            force_pin=force_pin,
        )
    except UsageError as error:
        return section_exit_code([fail(error), widget_code])
    if not updated:
        print("codex-usage-check: failed to update the usage dashboard message", file=sys.stderr)
        return section_exit_code([2, widget_code])
    predictions_code = 0
    reset_code = 0
    if quotas_usable:
        predictions_code = publish_predictions(config, view, force_pin=force_pin)
        try:
            reset_code = announce_window_resets(config, payload)
        except UsageError as error:
            print(f"codex-usage-check: {error}", file=sys.stderr)
            reset_code = error.exit_code
    return section_exit_code([*codes, widget_code, predictions_code, reset_code])


def fail(error: Exception) -> int:
    print(f"codex-usage-check: {error}", file=sys.stderr)
    return getattr(error, "exit_code", 2)


def acquire_update_lock() -> IO[str] | None:
    try:
        LOCK_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        descriptor = os.open(LOCK_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        handle = os.fdopen(descriptor, "w")
    except OSError as error:
        raise UsageError(f"failed to open update lock: {error}", 2) from error
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return None
    except OSError as error:
        handle.close()
        raise UsageError(f"failed to lock {LOCK_PATH}: {error}", 2) from error
    return handle


def run_json() -> int:
    try:
        payload = run_omp_usage()
    except UsageError as error:
        return fail(error)
    print(json.dumps(payload, indent=2))
    return 0


def run_relay(host: str) -> int:
    if valid_ssh_host(host) is None:
        print(f"codex-usage-check: invalid relay host: {host!r}", file=sys.stderr)
        return 1
    try:
        bundle = build_relay_bundle(time.time_ns() // 1_000_000)
    except UsageError as error:
        return fail(error)
    source = bundle["source"]
    temp_path = shlex.quote(f"{RELAY_REMOTE_DIR}/.{source}.tmp")
    final_path = shlex.quote(f"{RELAY_REMOTE_DIR}/{source}{RELAY_SUFFIX}")
    remote_command = (
        f"umask 077 && mkdir -p {shlex.quote(RELAY_REMOTE_DIR)} && cat > {temp_path} && "
        f"python3 -c {shlex.quote(RELAY_REMOTE_CHECK)} {temp_path} && mv {temp_path} {final_path}"
    )
    command = [
        TOKEN_SSH_BINARY,
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "ConnectTimeout=10",
        host,
        remote_command,
    ]
    try:
        completed = subprocess.run(
            command,
            input=gzip.compress(json.dumps(bundle).encode("utf-8"), mtime=0),
            timeout=RELAY_SSH_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired:
        print("codex-usage-check: relay ssh timed out", file=sys.stderr)
        return 2
    except OSError as error:
        print(f"codex-usage-check: relay ssh failed: {error}", file=sys.stderr)
        return 2
    if completed.returncode != 0:
        print(f"codex-usage-check: relay ssh exited {completed.returncode}", file=sys.stderr)
        return 2
    return 0


def run_telegram() -> int:
    config = load_config()
    if credentials(config) is None:
        print(
            "codex-usage-check: no Claude Telegram config; run: claude-usage-check --setup-telegram",
            file=sys.stderr,
        )
        return 1
    return publish_dashboard(config)


def setup_telegram() -> int:
    config = load_config()
    if credentials(config) is None:
        print(
            "codex-usage-check: no Claude Telegram config found; "
            "run: claude-usage-check --setup-telegram first",
            file=sys.stderr,
        )
        return 1
    try:
        me = tg_call(config["bot_token"], "getMe", {})
    except urllib.error.HTTPError as error:
        print(
            f"codex-usage-check: Telegram rejected getMe (HTTP {error.code}); "
            "fix the Claude config",
            file=sys.stderr,
        )
        return 1
    except (OSError, TimeoutError, TelegramError) as error:
        return fail(error)
    result = me.get("result")
    result = result if isinstance(result, dict) else {}
    bot_username = result.get("username") or "unknown"
    code = publish_dashboard(config, force_pin=True)
    if code == 0:
        print(f"Telegram bot @{bot_username} verified; dashboard photos pinned in the Claude chat.")
    else:
        print(f"Telegram bot @{bot_username} verified; dashboard publish reported issues (exit {code}).")
    return code


def main(argv: list[str]) -> int:
    selected = [flag for flag in ("--setup-telegram", "--telegram", "--relay") if flag in argv]
    unknown = [arg for arg in argv if arg.startswith("-") and arg not in selected]
    if unknown:
        print(f"codex-usage-check: unknown argument: {unknown[0]}", file=sys.stderr)
        return 1
    if "--relay" in selected:
        if len(selected) > 1:
            print("codex-usage-check: --relay cannot be combined with other modes", file=sys.stderr)
            return 1
        values = argv[argv.index("--relay") + 1 :]
        if len(values) != 1 or values[0].startswith("-"):
            print("codex-usage-check: --relay requires exactly one HOST", file=sys.stderr)
            return 1
        return run_relay(values[0])
    if len(selected) > 1:
        print("codex-usage-check: choose either --setup-telegram or --telegram", file=sys.stderr)
        return 1
    if "--setup-telegram" in selected or "--telegram" in selected:
        lock = acquire_update_lock()
        if lock is None:
            print("codex-usage-check: another telegram update is in progress, skipping", file=sys.stderr)
            return 0
        with lock:
            if "--setup-telegram" in selected:
                return setup_telegram()
            return run_telegram()
    return run_json()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
