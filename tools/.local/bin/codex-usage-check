class UsageError(Exception):
    """Running or validating the OMP usage payload failed."""

    def __init__(self, message: str, exit_code: int):
        super().__init__(message)
        self.exit_code = exit_code


class TelegramError(RuntimeError):
    """Telegram rejected a request or returned an unusable response."""
if str(TOKEN_USAGE_DIR) not in sys.path:
    sys.path.insert(0, str(TOKEN_USAGE_DIR))
try:
    import token_usage
except ImportError as error:
    token_usage = None
    TOKEN_USAGE_IMPORT_ERROR = error
else:
    TOKEN_USAGE_IMPORT_ERROR = None

try:
    import usage_history
except ImportError as error:
    usage_history = None
    USAGE_HISTORY_IMPORT_ERROR = error
else:
    USAGE_HISTORY_IMPORT_ERROR = None


def require_token_usage():
    if token_usage is None:
        raise UsageError("token usage collector not available", 1) from TOKEN_USAGE_IMPORT_ERROR
    return token_usage


def require_usage_history():
    if usage_history is None:
        raise UsageError("usage history collector not available", 1) from USAGE_HISTORY_IMPORT_ERROR
    return usage_history


def usable_report(report) -> bool:
    if not isinstance(report, dict):
        return False
    provider = report.get("provider")
    return isinstance(provider, str) and bool(provider.strip())


def usable_reports(payload: dict) -> list[dict]:
    reports = payload.get("reports")
    if not isinstance(reports, list):
        return []
    return [report for report in reports if usable_report(report)]


def run_omp_usage() -> dict:
    command = [os.environ.get("OMP_BIN", "omp"), "usage", "--json", "--redact"]
    try:
        completed = subprocess.run(
            command, capture_output=True, text=True, timeout=OMP_TIMEOUT_SECONDS, check=False
        )
    except FileNotFoundError:
        raise UsageError(f"OMP binary not found: {command[0]}", 1) from None
    except subprocess.TimeoutExpired:
        raise UsageError(f"OMP usage timed out after {OMP_TIMEOUT_SECONDS}s", 2) from None
    except OSError as error:
        raise UsageError(f"failed to run OMP: {error}", 2) from error
    if completed.returncode != 0:
        raise UsageError(f"OMP exited with code {completed.returncode}", 2)
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise UsageError(f"OMP produced invalid JSON: {error}", 1) from error
    if not isinstance(payload, dict):
        raise UsageError("OMP JSON payload is not an object", 1)
    reports = payload.get("reports")
    if not isinstance(reports, list):
        raise UsageError("OMP payload has no reports list", 1)
    if reports and not usable_reports(payload):
        raise UsageError("OMP payload has no provider reports", 1)
    return payload


def utc_today() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


def to_percent(used) -> float | None:
    if isinstance(used, bool) or not isinstance(used, (int, float)):
        return None
    value = float(used) * 100.0
    return max(0.0, min(100.0, value)) if math.isfinite(value) else None


def bar(percent: float | None) -> str:
    if percent is None:
        return BAR_EMPTY * BAR_CELLS
    filled = round(max(0.0, min(100.0, percent)) / 100 * BAR_CELLS)
    return BAR_FILLED * filled + BAR_EMPTY * (BAR_CELLS - filled)


def status_mark(percent: float | None, status) -> str:
    if status == "exhausted":
        return " 🚫"
    if status == "warning":
        return " ⚠️"
    if status == "unknown" or percent is None:
        return " (unknown)"
    if status == "ok":
        return ""
    if percent >= 100:
        return " 🚫"
    if percent >= WARNING_PERCENT:
        return " ⚠️"
    return ""


def reset_datetime(value) -> datetime | None:
    if value is None or isinstance(value, bool):
        return None
    if isinstance(value, (int, float)):
        seconds = float(value)
        if not math.isfinite(seconds):
            return None
        if seconds > 1_000_000_000_000:
            seconds /= 1000
        try:
            return datetime.fromtimestamp(seconds, tz=timezone.utc)
        except (OSError, OverflowError, ValueError):
            return None
    if isinstance(value, str):
        text = value.strip()
        if text.endswith(("Z", "z")):
            text = text[:-1] + "+00:00"
        try:
            moment = datetime.fromisoformat(text)
        except ValueError:
            return None
        if moment.tzinfo is None:
            moment = moment.replace(tzinfo=timezone.utc)
        return moment.astimezone(timezone.utc)
    return None


def fmt_reset(value) -> str:
    moment = reset_datetime(value)
    if moment is None:
        return ""
    if moment.date() == datetime.now(timezone.utc).date():
        return f"{moment.strftime('%H:%M')} UTC"
    return f"{moment.strftime('%b %d %H:%M')} UTC"


def fmt_duration(ms: int) -> str:
    seconds = ms / 1000
    if seconds <= 0:
        return "~now"
    if seconds < 3_600:
        count = max(1, math.ceil(seconds / 60))
        unit = "minute" if count == 1 else "minutes"
    elif seconds < 86_400:
        count = math.ceil(seconds / 3_600)
        unit = "hour" if count == 1 else "hours"
    else:
        count = math.ceil(seconds / 86_400)
        unit = "day" if count == 1 else "days"
    return f"~in {count} {unit}"


def fmt_reset_estimate(value) -> str:
    moment = reset_datetime(value)
    if moment is None:
        return ""
    diff_ms = int((moment - datetime.now(timezone.utc)).total_seconds() * 1000)
    return fmt_duration(diff_ms)


def limit_reset_key(limit: dict) -> tuple[int, datetime]:
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    moment = reset_datetime(window.get("resetsAt"))
    if moment is None:
        return 1, datetime.max.replace(tzinfo=timezone.utc)
    return 0, moment


def plan_metadata(plan) -> str:
    if isinstance(plan, str) and plan.strip():
        return escape(plan.strip())
    if isinstance(plan, dict):
        for key in ("name", "plan", "id", "title"):
            value = plan.get(key)
            if isinstance(value, str) and value.strip():
                return escape(value.strip())
    return ""


def limit_label(limit: dict) -> str:
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    scope = limit.get("scope")
    scope = scope if isinstance(scope, dict) else {}
    amount = limit.get("amount")
    amount = amount if isinstance(amount, dict) else {}
    label = limit.get("label") or window.get("label") or limit.get("id")
    label_text = str(label) if label else "?"
    additions = []
    tier = scope.get("tier")
    if isinstance(tier, str) and tier.strip() and tier.casefold() not in label_text.casefold():
        additions.append(tier.strip())
    window_label = window.get("label") or scope.get("windowId")
    if isinstance(window_label, str) and window_label.strip():
        window_text = window_label.strip()
        if window_text.casefold() != "quota window" and window_text.casefold() not in label_text.casefold():
            additions.append(window_text)
    unit = amount.get("unit")
    if isinstance(unit, str) and unit in ("requests", "tokens", "credits") and unit not in label_text.casefold():
        additions.append(unit)
    if additions:
        label_text += f" ({', '.join(additions)})"
    return escape(label_text)


def format_limit(limit: dict, label_width: int) -> str:
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    label_text = limit_label(limit)
    amount = limit.get("amount")
    amount = amount if isinstance(amount, dict) else {}
    percent = to_percent(amount.get("usedFraction"))
    percent_text = "?" if percent is None else f"{percent:5.1f}%"
    line = f"{bar(percent)} {percent_text:>6} · {label_text:<{label_width}}"
    raw_reset = window.get("resetsAt")
    when = fmt_reset_estimate(raw_reset)
    if when:
        line += f" · resets {when}"
    line += status_mark(percent, limit.get("status"))
    return f"<code>{line}</code>"


def provider_display(provider: str) -> str:
    known = PROVIDER_DISPLAY_NAMES.get(provider)
    if known:
        return escape(known)
    words = [part.title() for part in provider.split("-") if part]
    return escape(" ".join(words) if words else provider)


def format_message(payload: dict) -> str:
    header = f"<b>OMP usage</b> · {utc_today()}"
    updated = fmt_reset(payload.get("generatedAt"))
    if updated:
        header += f" · last updated {updated}"
    grouped: dict[str, list[dict]] = {}
    for report in usable_reports(payload):
        grouped.setdefault(report["provider"], []).append(report)
    label_width = 0
    for reports in grouped.values():
        for report in reports:
            limits = report.get("limits")
            if not isinstance(limits, list):
                continue
            for limit in limits:
                if isinstance(limit, dict):
                    label_width = max(label_width, len(limit_label(limit)))
    blocks = []
    for provider, reports in grouped.items():
        block = [f"<b>{provider_display(provider)}</b>"]
        for index, report in enumerate(reports, start=1):
            entry = []
            if len(reports) > 1:
                entry.append(f"<i>account {index}</i>")
            metadata = report.get("metadata")
            metadata = metadata if isinstance(metadata, dict) else {}
            plan = plan_metadata(metadata.get("planType"))
            if plan:
                entry.append(f"<i>plan: {plan}</i>")
            limits = report.get("limits")
            if isinstance(limits, list):
                for limit in sorted(
                    (limit for limit in limits if isinstance(limit, dict)),
                    key=limit_reset_key,
                ):
                    entry.append(format_limit(limit, label_width))
            if not entry:
                entry.append("No limits reported.")
            block.extend(entry)
        blocks.append("\n".join(block))
    if not blocks:
        return f"{header}\nNo provider reports."
    return "\n\n".join([header] + blocks)


FORECAST_PROVIDERS = ("openai-codex", "anthropic", "zai", "opencode-go")
SHORT_WINDOW_MS = 6 * 3_600_000
SHORT_LOOKBACK_MS = 3 * 3_600_000
LONG_LOOKBACK_MS = 24 * 3_600_000
MIN_RATE_SPAN_MS = 3_600_000
RESET_DROP = 0.02
HOT_FRACTION = 0.85
SPARE_FRACTION = 0.50


class Forecast(TypedDict):
    provider: str
    limit_id: str
    label: str
    used: float | None
    resets_at_ms: int | None
    window_ms: int | None
    rate_per_hour: float | None
    projected: float | None
    exhaust_in_ms: int | None
    verdict: str
    spark: list[float | None]


def history_series(snapshot: dict, provider: str, limit_id: str) -> list[tuple[int, float]]:
    samples = snapshot.get("samples")
    if not isinstance(samples, list):
        return []
    highest: dict[int, float] = {}
    for sample in samples:
        if not isinstance(sample, dict):
            continue
        if sample.get("provider") != provider or sample.get("limit_id") != limit_id:
            continue
        recorded_at = sample.get("recorded_at_ms")
        used_fraction = sample.get("used_fraction")
        if not isinstance(recorded_at, int) or isinstance(recorded_at, bool):
            continue
        if not isinstance(used_fraction, (int, float)) or isinstance(used_fraction, bool):
            continue
        fraction = float(used_fraction)
        previous = highest.get(recorded_at)
        if previous is None or fraction > previous:
            highest[recorded_at] = fraction
    return sorted(highest.items())


def burn_rate(series: list[tuple[int, float]], now_ms: int, used: float, lookback_ms: int) -> float | None:
    cutoff = now_ms - lookback_ms
    points = [point for point in series if cutoff <= point[0] <= now_ms]
    points.append((now_ms, used))
    start_index = 0
    for index in range(len(points) - 1):
        if points[index + 1][1] < points[index][1] - RESET_DROP:
            start_index = index + 1
    remaining = points[start_index:]
    first_time, first_fraction = remaining[0]
    span = now_ms - first_time
    if span < MIN_RATE_SPAN_MS:
        return None
    return max(0.0, (used - first_fraction) / (span / 3_600_000))


def spark_buckets(series: list[tuple[int, float]], now_ms: int, buckets: int = 48) -> list[float | None]:
    result: list[float | None] = []
    hour_ms = 3_600_000
    for i in range(buckets):
        start = now_ms - (buckets - i) * hour_ms
        end = now_ms - (buckets - i - 1) * hour_ms
        in_bucket = [fraction for recorded_at, fraction in series if start <= recorded_at < end]
        result.append(in_bucket[-1] if in_bucket else None)
    return result


def build_forecast(limit: dict, provider: str, snapshot: dict, now_ms: int) -> Forecast:
    limit_id = str(limit.get("id") or "")
    label = unescape(limit_label(limit))
    amount = limit.get("amount")
    amount = amount if isinstance(amount, dict) else {}
    used_percent = to_percent(amount.get("usedFraction"))
    used = used_percent / 100.0 if used_percent is not None else None
    window = limit.get("window")
    window = window if isinstance(window, dict) else {}
    moment = reset_datetime(window.get("resetsAt"))
    resets_at_ms = int(moment.timestamp() * 1000) if moment is not None else None
    duration = window.get("durationMs")
    window_ms = duration if isinstance(duration, int) and not isinstance(duration, bool) and duration > 0 else None
    lookback_ms = SHORT_LOOKBACK_MS if window_ms is not None and window_ms <= SHORT_WINDOW_MS else LONG_LOOKBACK_MS
    series = history_series(snapshot, provider, limit_id)
    rate = burn_rate(series, now_ms, used, lookback_ms) if used is not None else None
    hours_left = (resets_at_ms - now_ms) / 3_600_000 if (resets_at_ms is not None and resets_at_ms > now_ms) else None
    projected = min(1.0, used + rate * hours_left) if (rate is not None and hours_left is not None and used is not None) else None
    exhaust_in_ms = int((1.0 - used) / rate * 3_600_000) if (rate is not None and rate > 0 and used is not None and used < 1.0) else None
    status = limit.get("status")
    if used is None:
        verdict = "NO DATA"
    elif used >= 0.999 or status == "exhausted":
        verdict = "EXHAUSTED"
    elif rate is None or projected is None:
        verdict = "NO DATA"
    elif exhaust_in_ms is not None and hours_left is not None and exhaust_in_ms <= hours_left * 3_600_000:
        verdict = "RUN OUT"
    elif projected >= HOT_FRACTION:
        verdict = "HOT"
    elif projected >= SPARE_FRACTION:
        verdict = "ON PACE"
    else:
        verdict = "SPARE"
    spark = spark_buckets(series, now_ms, 48)
    return {
        "provider": provider,
        "limit_id": limit_id,
        "label": label,
        "used": used,
        "resets_at_ms": resets_at_ms,
        "window_ms": window_ms,
        "rate_per_hour": rate,
        "projected": projected,
        "exhaust_in_ms": exhaust_in_ms,
        "verdict": verdict,
        "spark": spark,
    }


def forecast_rows(payload: dict, snapshot: dict, now_ms: int) -> list[tuple[str, list[Forecast]]]:
    reports = usable_reports(payload)
    rows: list[tuple[str, list[Forecast]]] = []
    for provider in FORECAST_PROVIDERS:
        provider_reports = [report for report in reports if report.get("provider") == provider]
        limits: list[dict] = []
        for report in provider_reports:
            raw_limits = report.get("limits")
            if isinstance(raw_limits, list):
                limits.extend(limit for limit in raw_limits if isinstance(limit, dict))
        limits.sort(key=limit_reset_key)
        if not limits:
            continue
        forecasts = [build_forecast(limit, provider, snapshot, now_ms) for limit in limits]
        rows.append((provider, forecasts))
    return rows


def forecast_advice(f: Forecast, now_ms: int) -> str:
    verdict = f.get("verdict")
    if verdict == "EXHAUSTED":
        when = fmt_reset_estimate(f.get("resets_at_ms"))
        return f"exhausted \u00b7 wait, resets {when}" if when else "exhausted \u00b7 wait"
    if verdict == "RUN OUT":
        exhaust_in_ms = f.get("exhaust_in_ms") or 0
        resets_at_ms = f.get("resets_at_ms") or 0
        before_reset_ms = max(0, resets_at_ms - now_ms - exhaust_in_ms)
        return (
            f"tone it down \u00b7 hits 100% {fmt_duration(exhaust_in_ms)}, "
            f"{fmt_duration(before_reset_ms)} before reset"
        )
    if verdict == "HOT":
        projected = f.get("projected") or 0.0
        return f"ease off \u00b7 ~{projected * 100:.0f}% by reset"
    if verdict == "ON PACE":
        projected = f.get("projected") or 0.0
        return f"keep going \u00b7 ~{projected * 100:.0f}% by reset"
    if verdict == "SPARE":
        projected = f.get("projected") or 0.0
        return f"crank it up \u00b7 ~{(1.0 - projected) * 100:.0f}% spare by reset"
    if f.get("used") is None:
        return "no usage reported"
    return "not enough history yet"


def fmt_rate(f: Forecast | dict) -> str:
    rate = f.get("rate_per_hour")
    if rate is None:
        return "rate ?"
    window_ms = f.get("window_ms")
    if window_ms is not None and window_ms <= SHORT_WINDOW_MS:
        return f"+{rate * 100:.1f}%/h"
    return f"+{rate * 100 * 24:.1f}%/day"


def plain_image_text(html_text: str) -> str:
    text = re.sub(r"</?[A-Za-z][^>]*>", "", html_text)
    text = unescape(text)
    lines = []
    for raw_line in text.splitlines():
        line = raw_line.replace("\t", "    ")
        line = "".join(char if char.isprintable() else " " for char in line)
        line = line.replace("⚠️", "[!]").replace("🚫", "[X]")
        lines.append(line.rstrip())
    return "\n".join(lines).strip("\n")


def reset_estimate_seconds(line: str) -> int | None:
    match = re.search(r"resets ~in (\d+) (minutes?|hours?|days?)\b", line)
    if match is None:
        return None
    count = int(match.group(1))
    unit = match.group(2)
    if unit.startswith("minute"):
        return count * 60
    if unit.startswith("hour"):
        return count * 3_600
    if unit.startswith("day"):
        return count * 86_400
    return None


def image_line_color(line: str) -> str:
    if not line.startswith((BAR_FILLED, BAR_EMPTY)):
        return IMAGE_TEXT_COLOR
    if "[X]" in line:
        return IMAGE_BAD_COLOR
    if "[!]" in line:
        return IMAGE_WARNING_COLOR
    match = re.search(r"\s(\d+(?:\.\d+)?)%\s·", line)
    if match:
        percent = float(match.group(1))
        if percent >= 100:
            return IMAGE_BAD_COLOR
        if percent >= WARNING_PERCENT:
            return IMAGE_WARNING_COLOR
        reset_seconds = reset_estimate_seconds(line)
        if reset_seconds is not None and reset_seconds <= USE_RESET_SECONDS:
            return IMAGE_USE_COLOR
    if "?" in line:
        return IMAGE_MUTED_COLOR
    return IMAGE_GOOD_COLOR


def ffmpeg_filter_path(path: str) -> str:
    return path.replace("\\", "\\\\").replace(":", "\\:").replace(",", "\\,").replace("'", "\\'")


def render_image(text: str) -> bytes:
    lines = text.splitlines() or [""]
    if not any(lines):
        raise UsageError("usage image has no text", 2)
    longest = max(len(line) for line in lines)
    font_size = 28
    if longest > 70:
        font_size = 24
    if longest > 100:
        font_size = 20
    line_height = font_size + 14
    logo_size = font_size + 8
    logo_content_size = logo_size - 2 * LOGO_INSET
    content_width = longest * font_size * 0.62 + 96
    logo_specs = []
    for index, line in enumerate(lines):
        logo = PROVIDER_LOGOS.get(line)
        if logo:
            logo_filename, invert = logo
            logo_path = LOGO_DIR / logo_filename
            if not logo_path.is_file():
                raise UsageError(f"logo asset not found for {line}: {logo_path}", 2)
            logo_specs.append((index, logo_path, invert))
            content_width = max(
                content_width,
                len(line) * font_size * 0.62 + logo_size + 112,
            )
    width = max(900, int(content_width))
    height = max(180, 72 + len(lines) * line_height)
    if width % 2:
        width += 1
    if height % 2:
        height += 1
    ffmpeg = os.environ.get("FFMPEG_BIN", "ffmpeg")
    font_path = os.environ.get("OMP_USAGE_FONT", DEFAULT_FONT_PATH)
    try:
        with tempfile.TemporaryDirectory(prefix="omp-usage-") as directory:
            drawtext_filters = []
            logo_inputs = []
            logo_overlays = []
            logo_by_index = {
                index: (logo_path, invert)
                for index, logo_path, invert in logo_specs
            }
            for index, line in enumerate(lines):
                if not line:
                    continue
                y = 36 + index * line_height
                line_path = Path(directory) / f"line-{index:03d}.txt"
                line_path.write_text(line, encoding="utf-8")
                text_x = 48
                logo = logo_by_index.get(index)
                if logo:
                    logo_path, invert = logo
                    text_x += logo_size + 16
                    input_index = 1 + len(logo_overlays)
                    logo_inputs.extend(
                        ["-f", "svg_pipe", "-loop", "1", "-i", str(logo_path)]
                    )
                    logo_overlays.append((input_index, y, invert))
                drawtext_filters.append(
                    f"drawtext=fontfile={ffmpeg_filter_path(font_path)}:"
                    f"textfile={ffmpeg_filter_path(str(line_path))}:"
                    f"fontcolor={image_line_color(line)}:fontsize={font_size}:"
                    f"expansion=none:x={text_x}:y={y}"
                )
            if not drawtext_filters:
                raise UsageError("usage image has no text", 2)
            filter_parts = [f"[0:v]{','.join(drawtext_filters)}[base]"]
            last_label = "base"
            for index, (input_index, y, invert) in enumerate(logo_overlays):
                logo_label = f"logo{index}"
                logo_filters = []
                if invert:
                    logo_filters.append("lutrgb=r=negval:g=negval:b=negval")
                logo_filters.extend(
                    [
                        f"scale={logo_content_size}:{logo_content_size}:"
                        "force_original_aspect_ratio=decrease,"
                        f"pad={logo_size}:{logo_size}:(ow-iw)/2:(oh-ih)/2:color=0x00000000,"
                        "format=rgba",
                    ]
                )
                filter_parts.append(
                    f"[{input_index}:v]{','.join(logo_filters)}[{logo_label}]"
                )
                output_label = f"stage{index}"
                overlay_y = y + int(0.6 * font_size - logo_size / 2)
                filter_parts.append(
                    f"[{last_label}][{logo_label}]overlay=x=48:y={overlay_y}:"
                    f"eof_action=repeat:repeatlast=1[{output_label}]"
                )
                last_label = output_label
            filter_parts.append(f"[{last_label}]format=rgb24[out]")
            command = [
                ffmpeg,
                "-hide_banner",
                "-loglevel",
                "error",
                "-y",
                "-f",
                "lavfi",
                "-i",
                f"color=c=0x26263f:s={width}x{height}",
                *logo_inputs,
                "-filter_complex",
                ";".join(filter_parts),
                "-map",
                "[out]",
                "-frames:v",
                "1",
                "-f",
                "image2pipe",
                "-vcodec",
                "png",
                "pipe:1",
            ]
            try:
                completed = subprocess.run(
                    command,
                    capture_output=True,
                    timeout=FFMPEG_TIMEOUT_SECONDS,
                    check=False,
                )
            except FileNotFoundError:
                raise UsageError(f"ffmpeg binary not found: {ffmpeg}", 1) from None
            except subprocess.TimeoutExpired:
                raise UsageError(f"ffmpeg image render timed out after {FFMPEG_TIMEOUT_SECONDS}s", 2) from None
            except OSError as error:
                raise UsageError(f"failed to render usage image: {error}", 2) from error
            if completed.returncode != 0 or not completed.stdout:
                raise UsageError(
                    f"ffmpeg failed to render usage image (exit {completed.returncode})",
                    2,
                )
            return completed.stdout
    except UsageError:
        raise
    except OSError as error:
        raise UsageError(f"failed to prepare usage image: {error}", 2) from error


def load_config() -> dict | None:
    try:
        raw = CLAUDE_CONFIG_PATH.read_text(encoding="utf-8")
    except OSError:
        return None
    config = {}
    for line in raw.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            config[key.strip()] = value.strip()
    token = config.get("TELEGRAM_BOT_TOKEN")
    chat_id = config.get("TELEGRAM_CHAT_ID")
    if isinstance(token, str) and token and isinstance(chat_id, str) and chat_id:
        return {"bot_token": token, "chat_id": chat_id}
    return None


def credentials(config: dict | None) -> tuple[str, object] | None:
    if not isinstance(config, dict):
        return None
    token = config.get("bot_token")
    chat_id = config.get("chat_id")
    if not isinstance(token, str) or not token or chat_id in (None, ""):
        return None
    return token, chat_id


def load_state() -> dict:
    try:
        raw = CODEX_STATE_PATH.read_text(encoding="utf-8")
    except OSError:
        return {}
    try:
        state = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return state if isinstance(state, dict) else {}


def save_state(state: dict) -> None:
    CODEX_STATE_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(CODEX_STATE_PATH.parent, 0o700)
    descriptor, temporary = tempfile.mkstemp(
        dir=CODEX_STATE_PATH.parent, prefix=".state-", suffix=".tmp"
    )
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(state, handle, indent=2, sort_keys=True)
            handle.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, CODEX_STATE_PATH)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def tg_call(bot_token: str, method: str, params: dict) -> dict:
    request = urllib.request.Request(
        f"{TELEGRAM_API_BASE}/bot{bot_token}/{method}",
        data=json.dumps(params).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TELEGRAM_TIMEOUT_SECONDS) as response:
        body = response.read()
    try:
        payload = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise TelegramError(f"Telegram {method} returned invalid JSON: {error}") from error
    if not isinstance(payload, dict) or payload.get("ok") is not True:
        description = payload.get("description", "unknown error") if isinstance(payload, dict) else "malformed response"
        raise TelegramError(f"Telegram {method} failed: {description}")
    return payload


def multipart_form(
    fields: dict[str, object],
    file_field: str,
    filename: str,
    media: bytes,
) -> tuple[bytes, str]:
    boundary = f"----omp-usage-{uuid4().hex}"
    parts = []
    for name, value in fields.items():
        parts.extend(
            [
                f"--{boundary}\r\n".encode("ascii"),
                f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode("ascii"),
                str(value).encode("utf-8"),
                b"\r\n",
            ]
        )
    parts.extend(
        [
            f"--{boundary}\r\n".encode("ascii"),
            (
                f'Content-Disposition: form-data; name="{file_field}"; '
                f'filename="{filename}"\r\n'
            ).encode("ascii"),
            b"Content-Type: image/png\r\n\r\n",
            media,
            b"\r\n",
            f"--{boundary}--\r\n".encode("ascii"),
        ]
    )
    return b"".join(parts), boundary


def tg_upload(
    bot_token: str,
    method: str,
    fields: dict[str, object],
    file_field: str,
    filename: str,
    media: bytes,
) -> dict:
    body, boundary = multipart_form(fields, file_field, filename, media)
    request = urllib.request.Request(
        f"{TELEGRAM_API_BASE}/bot{bot_token}/{method}",
        data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TELEGRAM_TIMEOUT_SECONDS) as response:
        response_body = response.read()
    try:
        payload = json.loads(response_body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise TelegramError(f"Telegram {method} returned invalid JSON: {error}") from error
    if not isinstance(payload, dict) or payload.get("ok") is not True:
        description = (
            payload.get("description", "unknown error")
            if isinstance(payload, dict)
            else "malformed response"
        )
        raise TelegramError(f"Telegram {method} failed: {description}")
    return payload


def tg_send_photo(config: dict, image: bytes) -> int:
    payload = tg_upload(
        config["bot_token"],
        "sendPhoto",
        {"chat_id": config["chat_id"]},
        "photo",
        "omp-usage.png",
        image,
    )
    result = payload.get("result")
    result = result if isinstance(result, dict) else {}
    message_id = result.get("message_id")
    if not isinstance(message_id, int):
        raise TelegramError("Telegram sendPhoto returned no message_id")
    return message_id


def tg_edit_photo(config: dict, message_id: int, image: bytes) -> None:
    tg_upload(
        config["bot_token"],
        "editMessageMedia",
        {
            "chat_id": config["chat_id"],
            "message_id": message_id,
            "media": json.dumps(
                {"type": "photo", "media": "attach://photo"},
                separators=(",", ":"),
            ),
        },
        "photo",
        "omp-usage.png",
        image,
    )


def tg_pin(config: dict, message_id: int) -> None:
    tg_call(
        config["bot_token"],
        "pinChatMessage",
        {
            "chat_id": config["chat_id"],
            "message_id": message_id,
            "disable_notification": True,
        },
    )


def edit_failure_action(description: str) -> str:
    lowered = description.casefold()
    if "message is not modified" in lowered:
        return "ok"
    if "message to edit not found" in lowered:
        return "replace"
    return "fail"


def update_pinned(config: dict, image: bytes, state_key: str) -> bool:
    state = load_state()
    message_id = state.get(state_key)
    if isinstance(message_id, int):
        try:
            tg_edit_photo(config, message_id, image)
        except urllib.error.HTTPError as error:
            try:
                description = error.read().decode("utf-8", "replace")
            except (AttributeError, OSError, ValueError):
                description = ""
            action = edit_failure_action(description)
            if action == "ok":
                return True
            if action != "replace":
                return False
        except TelegramError as error:
            action = edit_failure_action(str(error))
            if action == "ok":
                return True
            if action != "replace":
                return False
        except (OSError, TimeoutError):
            return False
        else:
            try:
                tg_pin(config, message_id)
            except (urllib.error.HTTPError, OSError, TimeoutError, TelegramError):
                return False
            return True
    try:
        new_message_id = tg_send_photo(config, image)
    except (OSError, TimeoutError, TelegramError):
        return False
    state[state_key] = new_message_id
    try:
        save_state(state)
    except OSError:
        return False
    try:
        tg_pin(config, new_message_id)
    except (urllib.error.HTTPError, OSError, TimeoutError, TelegramError):
        return False
    return True


def build_image(payload: dict) -> tuple[bytes, int]:
    try:
        text = format_message(payload)
        return render_image(plain_image_text(text)), 0
    except UsageError:
        raise
    except (TypeError, ValueError, KeyError, AttributeError, OSError) as error:
        raise UsageError(f"failed to render usage image: {error}", 2) from error


def token_display_name(provider: str) -> str:
    known = PROVIDER_DISPLAY_NAMES.get(provider)
    if known:
        return known
    words = [part for part in provider.split("-") if part]
    return " ".join(word[:1].upper() + word[1:] for word in words) if words else provider


def token_provider_color(provider: str) -> str:
    known = TOKEN_PROVIDER_COLORS.get(provider)
    if known:
        return known
    digest = hashlib.sha256(provider.encode("utf-8")).digest()
    hue = int.from_bytes(digest[:2], "big") / 65536.0
    red, green, blue = colorsys.hsv_to_rgb(hue, 0.5, 0.9)
    return f"0x{round(red * 255):02x}{round(green * 255):02x}{round(blue * 255):02x}"


def valid_ssh_host(value: object) -> str | None:
    if not isinstance(value, str) or not value:
        return None
    if value.startswith("-") or any(char.isspace() for char in value):
        return None
    return value


def check_ssh_host() -> str | None:
    return valid_ssh_host(os.environ.get(TOKEN_SSH_HOST_ENV))


def collector_source(path: Path) -> bytes:
    try:
        return path.read_bytes()
    except OSError as error:
        raise UsageError(f"collector unreadable: {path.name}: {error}", 1) from error


def local_token_collection(start_ms: int, end_ms: int) -> tuple[str, dict | None, list[str]]:
    try:
        collection = token_usage.collect_usage(Path.home() / ".omp", start_ms, end_ms)
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        return "WSL", None, ["WSL unavailable: collector failure"]
    if not isinstance(collection, dict):
        return "WSL", None, ["WSL unavailable: invalid collection"]
    return "WSL", collection, []


def local_history_collection(start_ms: int, end_ms: int) -> tuple[str, dict | None, list[str]]:
    try:
        collection = usage_history.collect_history(Path.home() / ".omp", start_ms, end_ms)
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        return "WSL", None, ["WSL unavailable: collector failure"]
    if not isinstance(collection, dict):
        return "WSL", None, ["WSL unavailable: invalid collection"]
    return "WSL", collection, []


def remote_collection(host: str, source: bytes, start_ms: int, end_ms: int) -> tuple[str, dict | None, list[str]]:
    command = [
        TOKEN_SSH_BINARY,
        "-T",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=yes",
        "-o",
        "ConnectTimeout=10",
        "-o",
        "ServerAliveInterval=10",
        "-o",
        "ServerAliveCountMax=2",
        host,
        TOKEN_SSH_PYTHON,
        "-",
        "--start-ms",
        str(start_ms),
        "--end-ms",
        str(end_ms),
    ]
    try:
        completed = subprocess.run(
            command,
            input=source,
            capture_output=True,
            timeout=TOKEN_SSH_TIMEOUT_SECONDS,
            check=False,
        )
    except FileNotFoundError:
        return "mini-1", None, ["mini-1 unavailable: ssh binary not found"]
    except subprocess.TimeoutExpired:
        return "mini-1", None, ["mini-1 unavailable: ssh timed out"]
    except OSError as error:
        return "mini-1", None, [f"mini-1 unavailable: {error}"]
    stdout = completed.stdout or b""
    if completed.returncode == 255:
        print("codex-usage-check: token ssh connection failed", file=sys.stderr)
        return "mini-1", None, ["mini-1 unavailable: ssh connection failed"]
    if completed.returncode not in (0, 2):
        print(f"codex-usage-check: token ssh exited {completed.returncode}", file=sys.stderr)
        return "mini-1", None, [f"mini-1 unavailable: remote collector exited {completed.returncode}"]
    try:
        collection = json.loads(stdout.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        print("codex-usage-check: token ssh returned invalid JSON", file=sys.stderr)
        return "mini-1", None, ["mini-1 unavailable: invalid remote collection"]
    if not isinstance(collection, dict):
        print("codex-usage-check: token ssh returned invalid collection", file=sys.stderr)
        return "mini-1", None, ["mini-1 unavailable: invalid remote collection"]
    if completed.returncode == 2 and not collection.get("issues"):
        print("codex-usage-check: token ssh returned inconsistent collection", file=sys.stderr)
        return "mini-1", None, ["mini-1 unavailable: invalid remote collection"]
    return "mini-1", collection, []


def gather_collections(
    source_path: Path,
    local: Callable[[int, int], tuple[str, dict | None, list[str]]],
    start_ms: int,
    end_ms: int,
) -> tuple[list[tuple[str, dict]], list[str]]:
    collections: list[tuple[str, dict]] = []
    snapshot_issues: list[str] = []
    label, local_collection, local_issues = local(start_ms, end_ms)
    snapshot_issues.extend(local_issues)
    if local_collection is not None:
        collections.append((label, local_collection))
    host = check_ssh_host()
    if host is None:
        snapshot_issues.append("mini-1 unconfigured")
    else:
        try:
            source = collector_source(source_path)
        except UsageError as error:
            print(f"codex-usage-check: {error}", file=sys.stderr)
            snapshot_issues.append("mini-1 unavailable: collector unreadable")
            source = None
        if source is not None:
            label, remote_collection_result, remote_issues = remote_collection(host, source, start_ms, end_ms)
            snapshot_issues.extend(remote_issues)
            if remote_collection_result is not None:
                collections.append((label, remote_collection_result))
    return collections, snapshot_issues


def collect_token_snapshot(now_ms: int) -> token_usage.TokenSnapshot:
    require_token_usage()
    end_ms = now_ms
    start_ms = (end_ms // TOKEN_DAY_MS - TOKEN_LOOKBACK_DAYS + 1) * TOKEN_DAY_MS
    collections, issues = gather_collections(TOKEN_USAGE_PATH, local_token_collection, start_ms, end_ms)
    snapshot = token_usage.merge_usage(collections, start_ms, end_ms)
    if issues:
        snapshot["issues"] = [*issues, *snapshot.get("issues", [])]
    return snapshot


def collect_history_snapshot(now_ms: int) -> usage_history.HistorySnapshot:
    require_usage_history()
    end_ms = now_ms
    start_ms = end_ms - HISTORY_LOOKBACK_DAYS * TOKEN_DAY_MS
    collections, issues = gather_collections(USAGE_HISTORY_PATH, local_history_collection, start_ms, end_ms)
    snapshot = usage_history.merge_history(collections, start_ms, end_ms)
    if issues:
        snapshot["issues"] = [*issues, *snapshot.get("issues", [])]
    return snapshot


def format_compact_tokens(tokens: int) -> str:
    if tokens < 1000:
        return str(tokens)
    if tokens < 1_000_000:
        value = tokens / 1000
        text = f"{value:.1f}".rstrip("0").rstrip(".")
        return f"{text}K"
    if tokens < 1_000_000_000:
        value = tokens / 1_000_000
        text = f"{value:.1f}".rstrip("0").rstrip(".")
        return f"{text}M"
    value = tokens / 1_000_000_000
    text = f"{value:.1f}".rstrip("0").rstrip(".")
    return f"{text}B"


def token_axis_max(maximum: int) -> int:
    if maximum <= 0:
        return 1
    magnitude = 10 ** (len(str(maximum)) - 1)
    for multiple in (1, 2, 5, 10):
        ceiling = multiple * magnitude
        if ceiling >= maximum:
            return ceiling
    return 10 * magnitude


def format_price_label(provider: dict, incomplete: bool) -> str:
    tokens = provider.get("tokens", 0)
    cost = provider.get("estimated_usd", 0.0)
    unpriced = provider.get("unpriced_records", 0)
    prefix = "Known " if incomplete or unpriced else "Est. "
    if unpriced and tokens > 0 and (not isinstance(cost, (int, float)) or cost <= 0):
        return "Price unavailable"
    if tokens <= 0:
        return "$0.00"
    if unpriced:
        return f"{prefix}${cost:,.2f} + unpriced"
    if cost > 0 and cost < 0.01:
        return f"{prefix}<$0.01"
    return f"{prefix}${cost:,.2f}"


def format_estimate_label(value: float) -> str:
    if value <= 0:
        return ""
    if value < 0.01:
        return "~<$0.01"
    return f"~${value:,.2f}"


def render_token_chart(snapshot: token_usage.TokenSnapshot) -> bytes:
    providers = snapshot.get("providers", [])
    if not providers:
        raise UsageError("token chart has no providers", 2)
    days = snapshot.get("days", [])
    if not days:
        raise UsageError("token chart has no days", 2)
    count = len(days)
    total_tokens = sum(int(provider.get("tokens", 0)) for provider in providers)
    total_cost = math.fsum(float(provider.get("estimated_usd", 0.0)) for provider in providers)
    total_unpriced = sum(int(provider.get("unpriced_records", 0)) for provider in providers)
    total_estimated = math.fsum(float(provider.get("unpriced_estimated_usd", 0.0)) for provider in providers)
    day_totals = [int(day.get("tokens", 0)) for day in days]
    active_days = sum(1 for value in day_totals if value > 0)
    table_providers = sorted(
        providers,
        key=lambda item: (-int(item.get("tokens", 0)), str(item.get("provider", ""))),
    )
    width = 1600
    footer_y = 842 + 40 * len(table_providers) + 20
    height = footer_y + 104
    if height % 2:
        height += 1
    left, right, top, baseline = 104, 48, 350, 700
    plot_width = width - left - right
    plot_height = baseline - top
    axis_max = token_axis_max(max(day_totals) if day_totals else 0)
    slot = plot_width / count
    bar_width = max(1, int(min(64, slot * 0.72)))
    ffmpeg = os.environ.get("FFMPEG_BIN", "ffmpeg")
    font_path = os.environ.get("OMP_USAGE_FONT", DEFAULT_FONT_PATH)
    start = datetime.fromtimestamp(snapshot["start_ms"] / 1000, tz=timezone.utc)
    end = datetime.fromtimestamp(snapshot["end_ms"] / 1000, tz=timezone.utc)
    updated = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    sources_ok = snapshot.get("sources_ok", [])
    issues = snapshot.get("issues", [])
    incomplete = bool(issues)
    available = " + ".join(sources_ok) if sources_ok else "no sources"
    try:
        with tempfile.TemporaryDirectory(prefix="omp-tokens-") as directory:
            drawboxes: list[str] = []
            drawtexts: list[str] = []

            def text_filter(text: str, x: object, y: object, size: int, color: str) -> str:
                path = Path(directory) / f"token-{len(drawtexts):03d}.txt"
                path.write_text(text, encoding="utf-8")
                return (
                    f"drawtext=fontfile={ffmpeg_filter_path(font_path)}:"
                    f"textfile={ffmpeg_filter_path(str(path))}:"
                    f"fontcolor={color}:fontsize={size}:"
                    f"expansion=none:x={x}:y={y}"
                )

            def fit_size(text: str, base: int, minimum: int, max_width: int) -> int:
                size = base
                while size > minimum and len(text) * size * 0.62 > max_width:
                    size -= 1
                return size

            drawtexts.append(text_filter(f"OMP token usage \u00b7 Last {count} days", 48, 28, 36, TOKEN_TEXT_COLOR))
            drawtexts.append(text_filter(f"{start.strftime('%Y-%m-%d %H:%M UTC')} to {end.strftime('%Y-%m-%d %H:%M UTC')}", 48, 76, 22, TOKEN_MUTED_COLOR))
            drawtexts.append(text_filter(f"{available} \u00b7 Updated {updated}", 48, 106, 21, TOKEN_MUTED_COLOR))
            if incomplete:
                failed = []
                for issue in issues:
                    head = issue.split(":")[0]
                    if head and head not in failed:
                        failed.append(head)
                failure_text = "; ".join(failed)
                if len(failure_text) > 78:
                    failure_text = f"{failure_text[:77]}\u2026"
                warning = f"INCOMPLETE \u00b7 {available}"
                if failure_text:
                    warning = f"{warning} \u00b7 {failure_text}"
                if len(warning) > 118:
                    warning = f"{warning[:117]}\u2026"
                drawtexts.append(text_filter(warning, 48, 134, 20, TOKEN_WARNING_COLOR))
            observed = "Observed " if incomplete else ""
            panel_x = (48, 432, 816, 1200)
            panel_w, panel_h = 352, 112
            for x in panel_x:
                drawboxes.append(f"drawbox=x={x}:y=180:w={panel_w}:h={panel_h}:c={TOKEN_PANEL_COLOR}:t=fill")
            aggregate_cost = format_price_label(
                {"tokens": total_tokens, "estimated_usd": total_cost, "unpriced_records": total_unpriced},
                incomplete,
            )
            cost_note = (
                f"Unpriced est. {format_estimate_label(total_estimated)}" if total_estimated > 0 else None
            )
            panels = [
                (f"{observed}total tokens", f"{total_tokens:,}", None, TOKEN_MUTED_COLOR),
                (f"{observed}recorded cost", aggregate_cost, cost_note, TOKEN_ESTIMATE_COLOR),
                (f"{observed}avg/day", format_compact_tokens(round(total_tokens / count)), f"Active days: {active_days}/{count}", TOKEN_MUTED_COLOR),
                (f"{observed}peak day", None, None, TOKEN_MUTED_COLOR),
            ]
            if active_days:
                peak_index = max(range(count), key=day_totals.__getitem__)
                peak_date = datetime.fromtimestamp(int(days[peak_index].get("start_ms", snapshot["start_ms"])) / 1000, tz=timezone.utc)
                panels[3] = (
                    f"{observed}peak day",
                    format_compact_tokens(day_totals[peak_index]),
                    peak_date.strftime("%b %d %Y"),
                    TOKEN_MUTED_COLOR,
                )
            else:
                panels[3] = (f"{observed}peak day", "No activity", None, TOKEN_MUTED_COLOR)
            for x, (label, value, note, note_color) in zip(panel_x, panels):
                drawtexts.append(text_filter(label.capitalize(), x + 20, 194, 19, TOKEN_MUTED_COLOR))
                drawtexts.append(text_filter(value, x + 20, 222, fit_size(value, 27, 16, panel_w - 40), TOKEN_TEXT_COLOR))
                if note:
                    drawtexts.append(text_filter(note, x + 20, 260, 19, note_color))
            drawtexts.append(text_filter("Daily tokens \u00b7 UTC \u00b7 today is partial", 48, 318, 20, TOKEN_MUTED_COLOR))
            for level in range(6):
                value = axis_max * level // 5
                y = baseline - round(plot_height * level / 5)
                drawboxes.append(f"drawbox=x={left}:y={y}:w={plot_width}:h=1:c={TOKEN_GRID_COLOR}:t=fill")
                drawtexts.append(text_filter(format_compact_tokens(value), "(96)-tw", y - 14, 19, TOKEN_MUTED_COLOR))
            drawboxes.append(f"drawbox=x={left}:y={baseline}:w={plot_width}:h=2:c={TOKEN_AXIS_COLOR}:t=fill")
            if count <= 10:
                label_indexes = list(range(count))
            else:
                label_indexes = list(range(0, count, 5))
                final_index = count - 1
                if label_indexes[-1] != final_index:
                    if final_index - label_indexes[-1] <= 2:
                        label_indexes[-1] = final_index
                    else:
                        label_indexes.append(final_index)
            point_coords: list[tuple[int, int]] = []
            for index, day in enumerate(days):
                center = left + slot * index + slot / 2
                bar_x = int(center - bar_width / 2)
                day_providers = day.get("providers", [])
                totals_by_name = {str(item.get("provider", "")): int(item.get("tokens", 0)) for item in day_providers}
                cumulative = 0
                edge = 0
                for provider in providers:
                    name = str(provider.get("provider", ""))
                    seg_tokens = max(0, totals_by_name.get(name, 0))
                    if seg_tokens <= 0:
                        continue
                    cumulative += seg_tokens
                    next_edge = round(plot_height * cumulative / axis_max)
                    if next_edge > edge:
                        drawboxes.append(f"drawbox=x={bar_x}:y={baseline - next_edge}:w={bar_width}:h={next_edge - edge}:c={token_provider_color(name)}:t=fill")
                        edge = next_edge
                if day_totals[index] <= 0:
                    drawboxes.append(f"drawbox=x={bar_x}:y={baseline - 4}:w={bar_width}:h=4:c={TOKEN_AXIS_COLOR}:t=fill")
                if index in label_indexes:
                    day_start = datetime.fromtimestamp(int(day.get("start_ms", snapshot["start_ms"])) / 1000, tz=timezone.utc)
                    drawtexts.append(text_filter(day_start.strftime("%b %d"), f"({center})-tw/2", baseline + 18, 19, TOKEN_TEXT_COLOR))
                point_y = baseline - round(plot_height * day_totals[index] / axis_max)
                point_coords.append((int(center), point_y))
                if day_totals[index] > 0:
                    total_y = max(point_y - 21, top + 2)
                    drawtexts.append(text_filter(format_compact_tokens(day_totals[index]), f"({center})-tw/2", total_y, 16, TOKEN_MUTED_COLOR))
            for first, second in zip(point_coords, point_coords[1:]):
                steps = max(abs(second[0] - first[0]), abs(second[1] - first[1]), 1) // 3
                for step in range(int(steps) + 1):
                    fraction = step / steps if steps else 0
                    line_x = round(first[0] + (second[0] - first[0]) * fraction) - 1
                    line_y = round(first[1] + (second[1] - first[1]) * fraction) - 1
                    drawboxes.append(f"drawbox=x={line_x}:y={line_y}:w=3:h=3:c={TOKEN_TEXT_COLOR}:t=fill")
            for point_x, point_y in point_coords:
                drawboxes.append(f"drawbox=x={point_x - 3}:y={point_y - 3}:w=6:h=6:c={TOKEN_TEXT_COLOR}:t=fill")
            if total_tokens > 0:
                average_value = total_tokens / count
                average_y = baseline - round(plot_height * average_value / axis_max)
                dash_x = left
                dash_on = True
                while dash_x < left + plot_width:
                    dash_end = min(dash_x + (14 if dash_on else 10), left + plot_width)
                    if dash_on:
                        drawboxes.append(f"drawbox=x={int(dash_x)}:y={average_y}:w={int(dash_end - dash_x)}:h=2:c={TOKEN_WARNING_COLOR}:t=fill")
                    dash_x = dash_end
                    dash_on = not dash_on
                drawtexts.append(text_filter(f"Avg {format_compact_tokens(round(average_value))}/day", f"({width - right})-tw", average_y - 24, 19, TOKEN_WARNING_COLOR))
            drawtexts.append(text_filter("Provider breakdown", 48, 768, 22, TOKEN_TEXT_COLOR))
            drawtexts.append(text_filter("Provider", 88, 804, 19, TOKEN_MUTED_COLOR))
            drawtexts.append(text_filter("Recorded cost", "(1130)-tw", 804, 19, TOKEN_MUTED_COLOR))
            drawtexts.append(text_filter("Est. unpriced", "(1340)-tw", 804, 19, TOKEN_MUTED_COLOR))
            drawtexts.append(text_filter("Unpriced", "(1536)-tw", 804, 19, TOKEN_MUTED_COLOR))
            for row_index, provider in enumerate(table_providers):
                row_y = 842 + row_index * 40
                name = str(provider.get("provider", ""))
                display = token_display_name(name)
                if len(display) > 38:
                    display = f"{display[:37]}\u2026"
                tokens = int(provider.get("tokens", 0))
                share = tokens / total_tokens * 100 if total_tokens > 0 else 0.0
                estimate = format_estimate_label(float(provider.get("unpriced_estimated_usd", 0.0)))
                recorded = format_price_label(provider, incomplete)
                if estimate and recorded == "Price unavailable":
                    recorded = "$0.00"
                unpriced_count = int(provider.get("unpriced_records", 0))
                drawboxes.append(f"drawbox=x=48:y={row_y}:w=20:h=20:c={token_provider_color(name)}:t=fill")
                drawtexts.append(text_filter(display, 88, row_y, 20, TOKEN_TEXT_COLOR))
                drawtexts.append(text_filter(f"{tokens:,}", "(640)-tw", row_y, 20, TOKEN_MUTED_COLOR))
                drawtexts.append(text_filter(f"{share:.1f}%", "(800)-tw", row_y, 20, TOKEN_MUTED_COLOR))
                drawtexts.append(text_filter(recorded, "(1130)-tw", row_y, 20, TOKEN_MUTED_COLOR))
                if estimate:
                    drawtexts.append(text_filter(estimate, "(1340)-tw", row_y, 20, TOKEN_ESTIMATE_COLOR))
                elif unpriced_count:
                    drawtexts.append(text_filter("n/a", "(1340)-tw", row_y, 20, TOKEN_MUTED_COLOR))
                drawtexts.append(text_filter(str(unpriced_count), "(1536)-tw", row_y, 20, TOKEN_MUTED_COLOR))
            drawtexts.append(text_filter("Reported OMP tokens \u00b7 Recorded USD estimates, not subscription charges", 48, footer_y + 12, 19, TOKEN_MUTED_COLOR))
            drawtexts.append(text_filter("Antigravity includes AGY CLI; unavailable prices are not counted as free.", 48, footer_y + 42, 19, TOKEN_MUTED_COLOR))
            drawtexts.append(text_filter("Teal ~$ figures estimate unpriced tokens at logged blended model rates.", 48, footer_y + 72, 19, TOKEN_ESTIMATE_COLOR))
            command = [
                ffmpeg,
                "-hide_banner",
                "-loglevel",
                "error",
                "-y",
                "-f",
                "lavfi",
                "-i",
                f"color=c={TOKEN_BG_COLOR}:s={width}x{height}",
                "-filter_complex",
                f"[0:v]format=rgb24,{','.join([*drawboxes, *drawtexts])}[out]",
                "-map",
                "[out]",
                "-frames:v",
                "1",
                "-f",
                "image2pipe",
                "-vcodec",
                "png",
                "pipe:1",
            ]
            try:
                completed = subprocess.run(
                    command,
                    capture_output=True,
                    timeout=FFMPEG_TIMEOUT_SECONDS,
                    check=False,
                )
            except FileNotFoundError:
                raise UsageError(f"ffmpeg binary not found: {ffmpeg}", 1) from None
            except subprocess.TimeoutExpired:
                raise UsageError(f"ffmpeg token render timed out after {FFMPEG_TIMEOUT_SECONDS}s", 2) from None
            except OSError as error:
                raise UsageError(f"failed to render token chart: {error}", 2) from error
            if completed.returncode != 0 or not completed.stdout:
                raise UsageError(
                    f"ffmpeg failed to render token chart (exit {completed.returncode})",
                    2,
                )
            return completed.stdout
    except UsageError:
        raise
    except OSError as error:
        raise UsageError(f"failed to prepare token chart: {error}", 2) from error


def render_forecast_chart(rows: list[tuple[str, list[Forecast]]], snapshot: dict, now_ms: int) -> bytes:
    if not rows or not any(forecasts for _, forecasts in rows):
        raise UsageError("forecast chart has no limits", 2)
    width = 1600
    ffmpeg = os.environ.get("FFMPEG_BIN", "ffmpeg")
    font_path = os.environ.get("OMP_USAGE_FONT", DEFAULT_FONT_PATH)
    updated = datetime.fromtimestamp(now_ms / 1000, tz=timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    sources_ok = snapshot.get("sources_ok", [])
    available = " + ".join(sources_ok) if sources_ok else "no sources"
    issues = snapshot.get("issues", [])
    incomplete = bool(issues)
    try:
        with tempfile.TemporaryDirectory(prefix="omp-forecast-") as directory:
            drawboxes: list[str] = []
            drawtexts: list[str] = []

            def text_filter(text: str, x: object, y: object, size: int, color: str) -> str:
                path = Path(directory) / f"forecast-{len(drawtexts):03d}.txt"
                path.write_text(text, encoding="utf-8")
                return (
                    f"drawtext=fontfile={ffmpeg_filter_path(font_path)}:"
                    f"textfile={ffmpeg_filter_path(str(path))}:"
                    f"fontcolor={color}:fontsize={size}:"
                    f"expansion=none:x={x}:y={y}"
                )

            drawtexts.append(text_filter("OMP forecast \u00b7 at current pace", 48, 28, 36, TOKEN_TEXT_COLOR))
            drawtexts.append(text_filter(f"{available} \u00b7 history {HISTORY_LOOKBACK_DAYS}d \u00b7 Updated {updated}", 48, 76, 22, TOKEN_MUTED_COLOR))
            if incomplete:
                failed = []
                for issue in issues:
                    head = issue.split(":")[0]
                    if head and head not in failed:
                        failed.append(head)
                failure_text = "; ".join(failed)
                if len(failure_text) > 78:
                    failure_text = f"{failure_text[:77]}\u2026"
                warning = f"INCOMPLETE \u00b7 {available}"
                if failure_text:
                    warning = f"{warning} \u00b7 {failure_text}"
                if len(warning) > 118:
                    warning = f"{warning[:117]}\u2026"
                drawtexts.append(text_filter(warning, 48, 106, 20, TOKEN_WARNING_COLOR))
            drawtexts.append(text_filter("sparkline = last 48h of the window's used % (hourly) \u00b7 rate over last 24h (3h for 5h windows)", 48, 134, 20, TOKEN_MUTED_COLOR))

            y = 190
            for provider, forecasts in rows:
                drawboxes.append(f"drawbox=x=48:y={y + 6}:w=20:h=20:c={token_provider_color(provider)}:t=fill")
                display_name = unescape(provider_display(provider))
                drawtexts.append(text_filter(display_name, 88, y, 26, TOKEN_TEXT_COLOR))
                y += 44
                for f in forecasts:
                    drawboxes.append(f"drawbox=x=48:y={y}:w=336:h=48:c={TOKEN_PANEL_COLOR}:t=fill")
                    spark = f.get("spark") or []
                    for i, v in enumerate(spark):
                        if v is None:
                            continue
                        bar_h = max(1, round(v * 46))
                        bar_color = IMAGE_BAD_COLOR if v >= 1.0 else IMAGE_WARNING_COLOR if v >= 0.8 else IMAGE_GOOD_COLOR
                        drawboxes.append(f"drawbox=x={48 + i * 7}:y={y + 48 - bar_h}:w=6:h={bar_h}:c={bar_color}:t=fill")

                    label = f.get("label", "")
                    if len(label) > 58:
                        label = f"{label[:57]}\u2026"
                    drawtexts.append(text_filter(label, 416, y, 24, TOKEN_TEXT_COLOR))

                    used = f.get("used")
                    used_str = f"{used * 100:.1f}%" if used is not None else "?"
                    projected = f.get("projected")
                    projected_str = f"{projected * 100:.0f}%" if projected is not None else "?"
                    rate_str = fmt_rate(f)
                    resets_str = fmt_reset_estimate(f.get("resets_at_ms"))
                    detail = f"now {used_str} \u2192 {projected_str} at reset \u00b7 {rate_str}"
                    if resets_str:
                        detail += f" \u00b7 resets {resets_str}"
                    if len(detail) > 66:
                        detail = f"{detail[:65]}\u2026"
                    drawtexts.append(text_filter(detail, 416, y + 32, 21, TOKEN_MUTED_COLOR))

                    advice = forecast_advice(f, now_ms)
                    if len(advice) > 66:
                        advice = f"{advice[:65]}\u2026"
                    verdict = f.get("verdict", "NO DATA")
                    verdict_color = (
                        IMAGE_BAD_COLOR
                        if verdict in ("EXHAUSTED", "RUN OUT")
                        else IMAGE_WARNING_COLOR
                        if verdict == "HOT"
                        else IMAGE_GOOD_COLOR
                        if verdict == "ON PACE"
                        else TOKEN_ESTIMATE_COLOR
                        if verdict == "SPARE"
                        else TOKEN_AXIS_COLOR
                    )
                    drawtexts.append(text_filter(advice, 416, y + 62, 21, verdict_color))

                    drawboxes.append(f"drawbox=x=1300:y={y + 4}:w=252:h=36:c={verdict_color}:t=fill")
                    drawtexts.append(text_filter(verdict, 1316, y + 10, 22, "0x111827"))
                    y += 96
                y += 16

            height = y + 32
            if height % 2:
                height += 1

            command = [
                ffmpeg,
                "-hide_banner",
                "-loglevel",
                "error",
                "-y",
                "-f",
                "lavfi",
                "-i",
                f"color=c={TOKEN_BG_COLOR}:s={width}x{height}",
                "-filter_complex",
                f"[0:v]format=rgb24,{','.join([*drawboxes, *drawtexts])}[out]",
                "-map",
                "[out]",
                "-frames:v",
                "1",
                "-f",
                "image2pipe",
                "-vcodec",
                "png",
                "pipe:1",
            ]
            try:
                completed = subprocess.run(
                    command,
                    capture_output=True,
                    timeout=FFMPEG_TIMEOUT_SECONDS,
                    check=False,
                )
            except FileNotFoundError:
                raise UsageError(f"ffmpeg binary not found: {ffmpeg}", 1) from None
            except subprocess.TimeoutExpired:
                raise UsageError(f"ffmpeg forecast render timed out after {FFMPEG_TIMEOUT_SECONDS}s", 2) from None
            except OSError as error:
                raise UsageError(f"failed to render forecast chart: {error}", 2) from error
            if completed.returncode != 0 or not completed.stdout:
                raise UsageError(
                    f"ffmpeg failed to render forecast chart (exit {completed.returncode})",
                    2,
                )
            return completed.stdout
    except UsageError:
        raise
    except OSError as error:
        raise UsageError(f"failed to prepare forecast chart: {error}", 2) from error


def build_token_image(now_ms: int | None = None) -> tuple[bytes, int]:
    if now_ms is None:
        now_ms = time.time_ns() // 1_000_000
    snapshot = collect_token_snapshot(now_ms)
    try:
        image = render_token_chart(snapshot)
    except UsageError:
        raise
    except (TypeError, ValueError, KeyError, AttributeError, OSError) as error:
        raise UsageError(f"failed to render token chart: {error}", 2) from error
    return image, 2 if snapshot.get("issues") else 0


def build_forecast_image(payload: dict, now_ms: int | None = None) -> tuple[bytes, int]:
    if now_ms is None:
        now_ms = time.time_ns() // 1_000_000
    snapshot = collect_history_snapshot(now_ms)
    rows = forecast_rows(payload, snapshot, now_ms)
    try:
        image = render_forecast_chart(rows, snapshot, now_ms)
    except UsageError:
        raise
    except (TypeError, ValueError, KeyError, AttributeError, OSError) as error:
        raise UsageError(f"failed to render forecast chart: {error}", 2) from error
    return image, 2 if snapshot.get("issues") else 0


def publish_images(config: dict) -> int:
    status = 0
    try:
        payload = run_omp_usage()
    except UsageError as error:
        payload, payload_code = None, fail(error)
    else:
        payload_code = 0
    if payload is None:
        limits_code = forecast_code = payload_code
    else:
        try:
            limits_image, limits_code = build_image(payload)
        except UsageError as error:
            limits_image, limits_code = None, fail(error)
        else:
            if not update_pinned(config, limits_image, LIMITS_STATE_KEY):
                print("codex-usage-check: failed to update the limits Telegram message", file=sys.stderr)
                limits_code = 2
    try:
        token_image, token_code = build_token_image()
    except UsageError as error:
        token_image, token_code = None, fail(error)
    else:
        if not update_pinned(config, token_image, TOKENS_STATE_KEY):
            print("codex-usage-check: failed to update the token Telegram message", file=sys.stderr)
            token_code = 2
    if payload is not None:
        try:
            forecast_image, forecast_code = build_forecast_image(payload)
        except UsageError as error:
            forecast_image, forecast_code = None, fail(error)
        else:
            if not update_pinned(config, forecast_image, FORECAST_STATE_KEY):
                print("codex-usage-check: failed to update the forecast Telegram message", file=sys.stderr)
                forecast_code = 2
    for code in (limits_code, token_code, forecast_code):
        if code == 1:
            return 1
        if code == 2:
            status = 2
    return status


def fail(error: Exception) -> int:
    print(f"codex-usage-check: {error}", file=sys.stderr)
    return getattr(error, "exit_code", 2)


def run_json() -> int:
    try:
        payload = run_omp_usage()
    except UsageError as error:
        return fail(error)
    print(json.dumps(payload, indent=2))
    return 0


def run_telegram() -> int:
    config = load_config()
    if credentials(config) is None:
        print(
            "codex-usage-check: no Claude Telegram config; run: claude-usage-check --setup-telegram",
            file=sys.stderr,
        )
        return 1
    return publish_images(config)


def setup_telegram() -> int:
    config = load_config()
    if credentials(config) is None:
        print(
            "codex-usage-check: no Claude Telegram config found; "
            "run: claude-usage-check --setup-telegram first",
            file=sys.stderr,
        )
        return 1
    try:
        me = tg_call(config["bot_token"], "getMe", {})
    except urllib.error.HTTPError as error:
        print(
            f"codex-usage-check: Telegram rejected getMe (HTTP {error.code}); "
            "fix the Claude config",
            file=sys.stderr,
        )
        return 1
    except (OSError, TimeoutError, TelegramError) as error:
        return fail(error)
    result = me.get("result")
    result = result if isinstance(result, dict) else {}
    bot_username = result.get("username") or "unknown"
    code = publish_images(config)
    print(f"Telegram bot @{bot_username} verified; OMP provider usage, token chart, and forecast pinned in the Claude chat.")
    return code


def main(argv: list[str]) -> int:
    selected = [flag for flag in ("--setup-telegram", "--telegram") if flag in argv]
    unknown = [arg for arg in argv if arg.startswith("-") and arg not in selected]
    if unknown:
        print(f"codex-usage-check: unknown argument: {unknown[0]}", file=sys.stderr)
        return 1
    if len(selected) > 1:
        print("codex-usage-check: choose either --setup-telegram or --telegram", file=sys.stderr)
        return 1
    if "--setup-telegram" in selected:
        return setup_telegram()
    if "--telegram" in selected:
        return run_telegram()
    return run_json()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
