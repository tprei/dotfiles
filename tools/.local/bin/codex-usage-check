#!/usr/bin/env python3
"""OMP usage reporter: provider limits and seven-day token usage for Telegram.

Modes:
  codex-usage-check                  print the validated OMP JSON payload
  codex-usage-check --telegram       update the pinned limits and token images
  codex-usage-check --setup-telegram verify the Telegram config and pin both images

The Telegram bot token and chat come from ~/.config/claude-usage/config only;
delivery state lives in ~/.config/codex-usage/state.json with separate image IDs.
"""

from __future__ import annotations

