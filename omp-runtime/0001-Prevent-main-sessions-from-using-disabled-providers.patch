diff --git a/packages/coding-agent/src/session/main-agent-model-policy.ts b/packages/coding-agent/src/session/main-agent-model-policy.ts
new file mode 100644
index 0000000000..5dd221312d
--- /dev/null
+++ b/packages/coding-agent/src/session/main-agent-model-policy.ts
@@ -0,0 +1,16 @@
+import type { Settings } from "../config/settings";
+
+export function isMainAgentProviderDisabled(settings: Settings, agentKind: "main" | "sub", provider: string): boolean {
+	if (agentKind === "sub") return false;
+	const disabled: unknown = settings.get("mainAgent.disabledProviders");
+	if (!Array.isArray(disabled) || disabled.some(id => typeof id !== "string")) {
+		throw new Error("mainAgent.disabledProviders must be an array of provider IDs.");
+	}
+	return disabled.includes(provider);
+}
+
+export function assertMainAgentProviderAllowed(settings: Settings, agentKind: "main" | "sub", provider: string): void {
+	if (isMainAgentProviderDisabled(settings, agentKind, provider)) {
+		throw new Error(`Provider "${provider}" is disabled for the main driver.`);
+	}
+}
