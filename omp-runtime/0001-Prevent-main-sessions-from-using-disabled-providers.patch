index 0000000000000000000000000000000000000000..feebb9163817e9223472dfd63ab2b2491f8a3e46
--- /dev/null
+++ b/packages/coding-agent/test/acp-api-key-binding.test.ts
@@ -0,0 +1,110 @@
+import { afterEach, describe, expect, it, spyOn } from "bun:test";
+import { parseArgs } from "@oh-my-pi/pi-coding-agent/cli/args";
+import { cfgMainAgentDisabledProviders } from "@oh-my-pi/pi-coding-agent/config/model-settings";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { clearOmpExtensionCliRoots } from "@oh-my-pi/pi-coding-agent/discovery/omp-extension-roots";
+import { runRootCommand } from "@oh-my-pi/pi-coding-agent/main";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+// ACP `--api-key` binding follows the provider the unfiltered launch scope starts on: a
+// main-banned remembered default refuses the launch, while a banned scope entry next to an
+// allowed remembered default still binds the key to the remembered provider.
+describe("ACP --api-key provider resolution under main-driver bans", () => {
+	const tempDirs: TempDir[] = [];
+	const restores: Array<() => void> = [];
+
+	afterEach(() => {
+		clearOmpExtensionCliRoots();
+		for (const restore of restores.splice(0)) restore();
+		for (const dir of tempDirs.splice(0)) dir.remove();
+	});
+
+	async function runAcpWithKey(args: string[], settings: Settings) {
+		const authStorage = await AuthStorage.create(":memory:");
+		authStorage.keys.setRuntime("anthropic", "pre-anthropic");
+		authStorage.keys.setRuntime("openai", "pre-openai");
+		tempDirs.push(TempDir.createSync("@pi-acp-api-key-"));
+		const stderrChunks: string[] = [];
+		const stderrSpy = spyOn(process.stderr, "write").mockImplementation(((chunk: unknown) => {
+			stderrChunks.push(String(chunk));
+			return true;
+		}) as never);
+		restores.push(() => stderrSpy.mockRestore());
+		let exitCode: number | undefined;
+		const exitSpy = spyOn(process, "exit").mockImplementation(((code?: number) => {
+			exitCode = code ?? 0;
+			throw new Error(`process.exit(${exitCode})`);
+		}) as never);
+		restores.push(() => exitSpy.mockRestore());
+		const bindings: Array<[string, string]> = [];
+		const setRuntimeSpy = spyOn(authStorage.keys, "setRuntime").mockImplementation(((
+			provider: string,
+			key: string,
+		) => {
+			bindings.push([provider, key]);
+		}) as never);
+		restores.push(() => setRuntimeSpy.mockRestore());
+		let acpRan = false;
+		try {
+			await runRootCommand(parseArgs(args), args, {
+				discoverAuthStorage: async () => authStorage,
+				settings,
+				runAcpMode: (async () => {
+					acpRan = true;
+					return undefined as never;
+				}) as never,
+			});
+		} catch (error) {
+			if (!(error instanceof Error) || !error.message.startsWith("process.exit(")) throw error;
+		}
+		return { authStorage, bindings, stderr: stderrChunks.join(""), exitCode, acpRan };
+	}
+
+	it("refuses and does not bind when the remembered default is main-banned", async () => {
+		const settings = Settings.isolated({ "compaction.enabled": false });
+		settings.setModelRole("default", "anthropic/claude-sonnet-4-5");
+		cfgMainAgentDisabledProviders.override(settings, ["anthropic"]);
+
+		const { bindings, stderr, exitCode, acpRan } = await runAcpWithKey(
