From 9170533b6428ed7de2b6ec034bbd7e0256170803 Mon Sep 17 00:00:00 2001
From: tprei <37089330+tprei@users.noreply.github.com>
Date: Wed, 16 Sep 2026 14:47:45 +0100
Subject: [PATCH 3/3] Stop the legacy pi shim from resolving canonical
 specifiers

Canonical @oh-my-pi/pi-* specifiers remap to themselves, so the shim's own Bun.resolveSync re-entered its onResolve handler and Bun stacked a file: namespace prefix per level until it aborted with NameTooLong. That killed /login, which requires @oh-my-pi/pi-ai/index.js at runtime. Bun resolves those specifiers unaided, so hand them back after checking the bundled package-root overrides.
---
 .../extensibility/plugins/legacy-pi-compat.ts | 17 +++++-
 .../legacy-pi-canonical-scope-resolve.test.ts | 52 +++++++++++++++++++
 2 files changed, 68 insertions(+), 1 deletion(-)
 create mode 100644 packages/coding-agent/test/extensibility/legacy-pi-canonical-scope-resolve.test.ts

diff --git a/packages/coding-agent/src/extensibility/plugins/legacy-pi-compat.ts b/packages/coding-agent/src/extensibility/plugins/legacy-pi-compat.ts
index dbb98e1935..2c3a2db1f0 100644
--- a/packages/coding-agent/src/extensibility/plugins/legacy-pi-compat.ts
+++ b/packages/coding-agent/src/extensibility/plugins/legacy-pi-compat.ts
@@ -2655,10 +2655,25 @@ function resolveLegacyPiSpecifier(args: { path: string; importer: string }): Leg
 		return undefined;
 	}
 
+	const packageRootOverride = legacyPiPackageRootOverrides[remappedSpecifier];
+	if (packageRootOverride) {
+		return toLegacyPiResolveResult(packageRootOverride);
+	}
+
+	// `@oh-my-pi` is one of the scopes this handler claims, so a canonical
+	// specifier remaps to itself: resolving it below re-enters this handler for
+	// the identical path, and Bun stacks a `file:` namespace prefix per nested
+	// resolution until it aborts with `BuildMessage: NameTooLong` (that killed
+	// `/login`, which reaches `@oh-my-pi/pi-ai/index.js` through `require`).
+	// Bun resolves canonical specifiers without help, so hand them back.
+	if (remappedSpecifier === args.path) {
+		return undefined;
+	}
+
 	// Primary: resolve the canonical @oh-my-pi/* specifier from the host binary
 	// location. Works in dev mode and in source-link installs.
 	try {
-		return toLegacyPiResolveResult(resolveCanonicalPiSpecifier(remappedSpecifier));
+		return toLegacyPiResolveResult(getResolvedSpecifier(remappedSpecifier));
 	} catch {
 		// Fallback for compiled binary mode: the bundled packages live inside
 		// /$bunfs/root and aren't reachable by filesystem resolution. Prefer the
diff --git a/packages/coding-agent/test/extensibility/legacy-pi-canonical-scope-resolve.test.ts b/packages/coding-agent/test/extensibility/legacy-pi-canonical-scope-resolve.test.ts
new file mode 100644
index 0000000000..8a1bad846d
--- /dev/null
+++ b/packages/coding-agent/test/extensibility/legacy-pi-canonical-scope-resolve.test.ts
@@ -0,0 +1,52 @@
+import { afterAll, describe, expect, it } from "bun:test";
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { installLegacyPiSpecifierShim } from "@oh-my-pi/pi-coding-agent/extensibility/plugins/legacy-pi-compat";
+import { removeWithRetries } from "@oh-my-pi/pi-utils";
+
+// `@oh-my-pi` is one of the scopes the shim claims, so a canonical specifier
+// remaps to itself. While the shim resolved those itself, its own
+// `Bun.resolveSync` re-entered the `onResolve` handler for the identical path
+// until Bun aborted with `BuildMessage: NameTooLong reading "file:file:…"`,
+// which killed `/login`: `loadProviderAuthUi()` in
+// `modes/controllers/selector-controller.ts` reaches both modules below through
+// `require`.
+installLegacyPiSpecifierShim();
+
+const tempRoots: string[] = [];
+
+afterAll(async () => {
+	for (const dir of tempRoots) {
+		await removeWithRetries(dir);
+	}
+});
+
+describe("legacy-pi shim canonical @oh-my-pi specifiers", () => {
+	it("resolves the pi-ai subpaths /login requires", async () => {
+		// The fixture lives beside this test, not in the OS temp dir, because
+		// canonical specifiers resolve through the workspace `node_modules` that
+		// the repo tree provides — same as the host modules that hit this path.
+		const dir = await fs.mkdtemp(path.join(import.meta.dir, "canonical-scope-fixture-"));
+		tempRoots.push(dir);
+		const entry = path.join(dir, "index.ts");
+		await fs.writeFile(
+			entry,
+			[
+				'export const ai = require("@oh-my-pi/pi-ai/index.js");',
+				'export const oauth = require("@oh-my-pi/pi-ai/registry/oauth/index.js");',
+			].join("\n"),
+			"utf8",
+		);
+
+		// Importing a runtime-generated path after the shim install reproduces
+		// production ordering: Bun mangles a plugin's resolved path into
+		// `file:<path>` once the requiring module is already in the graph.
+		const loaded = (await import(entry)) as {
+			ai: { PASTE_CODE_LOGIN_PROVIDERS: unknown };
+			oauth: { getOAuthProviders: () => Array<{ id: string }> };
+		};
+
+		expect(loaded.ai.PASTE_CODE_LOGIN_PROVIDERS).toBeInstanceOf(Set);
+		expect(loaded.oauth.getOAuthProviders().some(provider => provider.id === "anthropic")).toBe(true);
+	});
+});
