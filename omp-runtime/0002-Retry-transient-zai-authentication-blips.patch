 function authError(status = 401): Error & { status: number } {
 	return Object.assign(new Error(`${status} authentication_error`), { status });
@@ -122,6 +123,43 @@ describe("isAuthRetryableError", () => {
 	});
 });
 
+describe("isTransientZaiAuthBlip", () => {
+	const openAiBlip = '401 {"error":{"message":"Authentication Failed","type":"1000"}}';
+	const turnBlip = "401 Authentication Failed\nAuthentication Failed (type=1000)";
+
+	it("matches the z.ai type-1000 blip in its observed shapes", () => {
+		expect(isTransientZaiAuthBlip("zai", Object.assign(new Error(openAiBlip), { status: 401 }))).toBe(true);
+		expect(isTransientZaiAuthBlip("zai", new ProviderHttpError(openAiBlip, 401))).toBe(true);
+		expect(isTransientZaiAuthBlip("zai", turnBlip)).toBe(true);
+		expect(isTransientZaiAuthBlip("zai", openAiBlip)).toBe(true);
+	});
+
+	it("classifies the observed response as retriable for turn recovery", () => {
+		const id = AIError.classifyMessage({
+			provider: "zai",
+			model: "glm-5.3",
+			errorStatus: 401,
+			errorMessage: openAiBlip,
+		});
+		expect(AIError.is(id, AIError.Flag.AuthFailed)).toBe(true);
+		expect(AIError.is(id, AIError.Flag.Transient)).toBe(true);
+		expect(AIError.retriable(id)).toBe(true);
+	});
+
+	it("rejects other providers, other statuses, and unmarked 401s", () => {
+		expect(isTransientZaiAuthBlip("openai", new Error(openAiBlip))).toBe(false);
+		expect(isTransientZaiAuthBlip("zai", authError())).toBe(false);
+		expect(
+			isTransientZaiAuthBlip(
+				"zai",
+				Object.assign(new Error("500 Authentication Failed (type=1000)"), { status: 500 }),
+			),
+		).toBe(false);
+		expect(isTransientZaiAuthBlip("zai", new Error("network blip"))).toBe(false);
+		expect(isTransientZaiAuthBlip("zai", undefined)).toBe(false);
+	});
+});
+
 describe("withAuth", () => {
 	it("runs a single attempt for a static string key (no retry)", async () => {
 		const keys: Array<string | undefined> = [];
diff --git a/packages/ai/test/auth-storage-zai-api-key-selection.test.ts b/packages/ai/test/auth-storage-zai-api-key-selection.test.ts
