 		expect(await authStorage.getApiKey("zai")).toBe("zai-feature-exhausted");
 	});
+
+	test("leaves the lone credential unblocked on a transient z.ai auth blip", async () => {
+		if (!authStorage || !store?.listCredentialBlocks) throw new Error("test setup failed");
+		await authStorage.set("zai", [{ type: "api_key", key: "zai-key" }]);
+		const row = store.listAuthCredentials("zai")[0];
+		if (!row) throw new Error("expected stored zai credential");
+
+		expect(await authStorage.getApiKey("zai", "zai-blip")).toBe("zai-key");
+		const blip = Object.assign(new Error('401 {"error":{"message":"Authentication Failed","type":"1000"}}'), {
+			status: 401,
+		});
+		const rotated = await authStorage.rotateSessionCredential("zai", "zai-blip", {
+			error: blip,
+			apiKey: "zai-key",
+		});
+
+		expect(rotated).toBe(false);
+		expect(store.listCredentialBlocks([row.id])).toEqual([]);
+		expect(await authStorage.getApiKey("zai", "zai-blip")).toBe("zai-key");
+	});
+
+	test("still blocks the lone credential on a plain z.ai 401", async () => {
+		if (!authStorage || !store?.listCredentialBlocks) throw new Error("test setup failed");
+		await authStorage.set("zai", [{ type: "api_key", key: "zai-key" }]);
+		const row = store.listAuthCredentials("zai")[0];
+		if (!row) throw new Error("expected stored zai credential");
+
+		const rotated = await authStorage.rotateSessionCredential("zai", "zai-plain", {
+			error: Object.assign(new Error("401 authentication_error"), { status: 401 }),
+			apiKey: "zai-key",
+		});
+
+		expect(rotated).toBe(false);
+		const blocks = store.listCredentialBlocks([row.id]);
+		expect(blocks).toHaveLength(1);
+		expect(blocks[0]?.blockedUntilMs).toBeGreaterThan(Date.now());
+	});
 });
