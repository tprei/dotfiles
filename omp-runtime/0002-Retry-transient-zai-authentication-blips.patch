diff --git a/packages/ai/src/error/auth-classify.ts b/packages/ai/src/error/auth-classify.ts
index c13461b..036be45 100644
--- a/packages/ai/src/error/auth-classify.ts
+++ b/packages/ai/src/error/auth-classify.ts
@@ -1,5 +1,11 @@
 import { extractHttpStatusFromError } from "@oh-my-pi/pi-utils";
-import { isAccountPolicyError, isClinePassSurfaceGateMessage, isOAuthExpiry, isUsageLimit } from "./flags";
+import {
+	isAccountPolicyError,
+	isClinePassSurfaceGateMessage,
+	isOAuthExpiry,
+	isUsageLimit,
+	isZaiTransientAuthBlipMessage,
+} from "./flags";
 import { OAuthError } from "./oauth";
 import { isConcurrencyCapExclusion, isUsageLimitOutcome } from "./rate-limit";
 
@@ -52,3 +58,24 @@ export function isAuthRetryableError(error: unknown): boolean {
 	if (status === 401 || status === 403) return true;
 	return isUsageLimitOutcome(status, message);
 }
+
+const LEADING_HTTP_STATUS_PATTERN = /^\s*(\d{3})\b/;
+
+/**
+ * Whether a 401 is z.ai's transient key-validation blip instead of a dead
+ * credential. z.ai intermittently rejects valid keys on the chat endpoints
+ * with `401 {"error":{"message":"Authentication Failed","type":"1000"}}`
+ * and accepts the same key seconds later. Match narrowly on provider,
+ * status, and the type-1000 marker so genuinely revoked keys keep the
+ * hard-auth path.
+ */
+export function isTransientZaiAuthBlip(provider: string, error: unknown): boolean {
+	if (provider !== "zai") return false;
+	const httpStatus = extractHttpStatusFromError(error);
+	const message = error instanceof Error ? error.message : typeof error === "string" ? error : undefined;
+	const embeddedStatus = message ? extractHttpStatusFromError({ message }) : undefined;
+	const leadingStatus = message ? LEADING_HTTP_STATUS_PATTERN.exec(message)?.[1] : undefined;
+	const status = httpStatus ?? embeddedStatus ?? (leadingStatus === undefined ? undefined : Number(leadingStatus));
+	if (status !== 401 || message === undefined) return false;
+	return isZaiTransientAuthBlipMessage(message);
+}
