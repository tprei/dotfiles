{
  "keymap": "tmux",
  "keymap_prefix": "ctrl+a",
  "option_as_alt": "both",
  "keybinds": {
    "cmd+a": "text:\\x01",
    "cmd+d": "text:\\x04",
    "cmd+shift+p": "unbind",
    "ctrl+shift+v": "paste",

    "ctrl+a>c": "new_tab",
    "ctrl+a>n": "next_tab",
    "ctrl+a>p": "previous_tab",
    "ctrl+a>shift+x": "close_tab",
    "ctrl+a>comma": "rename_tab",
    "ctrl+a>shift+t": "rename_tab",
    "ctrl+a>shift+left": "move_tab_left",
    "ctrl+a>shift+right": "move_tab_right",
    "ctrl+a>v": "split_right",
    "ctrl+a>minus": "split_right",
    "ctrl+a>equal": "split_down",
    "ctrl+a>x": "close_pane",
    "ctrl+a>z": "zoom",
    "ctrl+a>h": "focus_pane:left",
    "ctrl+a>j": "focus_pane:down",
    "ctrl+a>k": "focus_pane:up",
    "ctrl+a>l": "focus_pane:right",
    "ctrl+a>shift+h": "move_pane:left",
    "ctrl+a>shift+l": "move_pane:right",
    "ctrl+a>e": "open_scrollback",
    "ctrl+a>g": "mission_control",
    "ctrl+a>o": "inbox",
    "ctrl+a>w": "switch_session",
    "ctrl+a>s": "switch_session",
    "ctrl+a>shift+n": "new_session",
    "ctrl+a>shift+w": "rename_session",
    "ctrl+a>shift+d": "close_session",
    "ctrl+a>shift+/": "palette",
    "ctrl+a>shift+s": "preferences",
    "ctrl+a>r": "reload_config",
    "ctrl+a>ctrl+l": "text:\\x0c",

    "alt+c": "new_tab",
    "alt+n": "next_tab",
    "alt+j": "plugin.nav.next_session",
    "alt+p": "previous_tab",
    "alt+k": "plugin.nav.previous_session",
    "alt+x": "close_tab",
    "alt+r": "rename_tab",
    "alt+digit_1": "goto_tab:1",
    "alt+digit_2": "goto_tab:2",
    "alt+digit_3": "goto_tab:3",
    "alt+digit_4": "goto_tab:4",
    "alt+digit_5": "goto_tab:5",
    "alt+digit_6": "goto_tab:6",
    "alt+digit_7": "goto_tab:7",
    "alt+digit_8": "goto_tab:8",
    "alt+digit_9": "goto_tab:9",
    "ctrl+shift+left": "move_tab_left",
    "ctrl+shift+right": "move_tab_right",
    "alt+minus": "split_right",
    "alt+equal": "split_down",
    "alt+z": "zoom",
    "alt+h": "resize_split:left",
    "alt+l": "resize_split:right",
    "alt+left": "move_pane:left",
    "alt+right": "move_pane:right",
    "ctrl+alt+h": "focus_pane:left",
    "ctrl+alt+j": "focus_pane:down",
    "ctrl+alt+k": "focus_pane:up",
    "ctrl+alt+l": "focus_pane:right",
    "alt+e": "open_scrollback",
    "alt+g": "mission_control",
    "alt+w": "mission_control",
    "alt+o": "inbox",
    "alt+shift+/": "palette",
    "alt+shift+c": "new_session",
    "alt+shift+r": "rename_session",
    "alt+shift+x": "close_session",
    "alt+shift+w": "switch_session",

    "ctrl+h": "plugin.nav.left",
    "ctrl+j": "plugin.nav.down",
    "ctrl+k": "plugin.nav.up",
    "ctrl+l": "plugin.nav.right",
    "alt+shift+n": "plugin.nav.next_session",
    "alt+shift+j": "plugin.nav.next_session",
    "alt+shift+p": "plugin.nav.previous_session",
    "alt+shift+k": "plugin.nav.previous_session",
    "alt+shift+digit_1": "plugin.nav.session_1",
    "alt+shift+digit_2": "plugin.nav.session_2",
    "alt+shift+digit_3": "plugin.nav.session_3",
    "alt+shift+digit_4": "plugin.nav.session_4",
    "alt+shift+digit_5": "plugin.nav.session_5",
    "alt+shift+digit_6": "plugin.nav.session_6",
    "alt+shift+digit_7": "plugin.nav.session_7",
    "alt+shift+digit_8": "plugin.nav.session_8",
    "alt+shift+digit_9": "plugin.nav.session_9",
    "ctrl+alt+digit_1": "plugin.nav.agent_1",
    "ctrl+alt+digit_2": "plugin.nav.agent_2",
    "ctrl+alt+digit_3": "plugin.nav.agent_3",
    "ctrl+alt+digit_4": "plugin.nav.agent_4",
    "ctrl+alt+digit_5": "plugin.nav.agent_5",
    "ctrl+alt+digit_6": "plugin.nav.agent_6",
    "ctrl+alt+digit_7": "plugin.nav.agent_7",
    "ctrl+alt+digit_8": "plugin.nav.agent_8",
    "ctrl+alt+digit_9": "plugin.nav.agent_9"
  }
}
